rl = @import("raylib");

title: Array(char, 14) = "bisect if call";
mut frames: i32 = 0;

rl.InitWindow(320, 240, &title[0]);
rl.SetTargetFPS(60);

while(!rl.WindowShouldClose() && frames < 2) {
    if(rl.IsKeyPressed(32)) {
        frames = frames + 1;
    }

    rl.BeginDrawing();
    rl.ClearBackground(rl.RAYWHITE);
    rl.EndDrawing();
    frames = frames + 1;
}

rl.CloseWindow();
