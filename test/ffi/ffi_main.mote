c_mem :: @import("c:memory");
c_file :: @import("c:file");
c_io :: @import("c:io");

heap: *char = c_mem.malloc(1);
*heap = 'A';
c_io.putchar(*heap);
c_mem.free(heap);

data: Array(char, 5) = ['h', 'e', 'l', 'l', 'o'];
copy: Array(char, 5) = @zero(Array(char, 5));
c_mem.memcpy(&copy[0], &data[0], 5);
c_mem.memset(&copy[0], 'x', 1);

writer: *void = c_file.fopen("ffi_out.txt", "wb");
written: i64 = c_file.fwrite(&copy[0], 1, 5, writer);
c_file.fclose(writer);

read_back: Array(char, 5) = @zero(Array(char, 5));
reader: *void = c_file.fopen("ffi_out.txt", "rb");
read_count: i64 = c_file.fread(&read_back[0], 1, 5, reader);
c_file.fclose(reader);

if(written == 5 && read_count == 5 && read_back[0] == 'x' && read_back[1] == 'e') {
    c_io.putchar('O');
    c_io.putchar('K');
}

c_io.putchar('\n');
c_file.remove("ffi_out.txt");