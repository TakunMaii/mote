linalg :: @import("std:linalg");
math :: @import("std:math");

approx_eq :: fn(a: f32, b: f32, eps: f32) bool {
    return math.abs_f32(a - b) <= eps;
};

main :: fn() i32 {
    a := linalg.vec3(1.0, 2.0, 3.0);
    b := linalg.vec3(4.0, 5.0, 6.0);

    sum := a + b;
    diff := b - a;
    scaled := a * 2.0;
    norm := linalg.normalize3(linalg.vec3(0.0, 3.0, 4.0));
    cross := linalg.cross3(a, b);
    dot := linalg.dot3(a, b);

    model := linalg.translation4(linalg.vec3(2.0, 0.0, 0.0)) *
            linalg.scaling4(linalg.vec3(2.0, 2.0, 2.0));
    p := linalg.transform_point3(model, linalg.vec3(1.0, 2.0, 3.0));
    dir := linalg.transform_vector3(model, linalg.vec3(1.0, 0.0, 0.0));

    rot := linalg.rotation_y4(math.PI_F32 * 0.5);
    rotated := linalg.transform_vector3(rot, linalg.vec3(1.0, 0.0, 0.0));

    proj := linalg.perspective4(math.PI_F32 * 0.5, 16.0 / 9.0, 0.1, 100.0);
    view := linalg.look_at4(
        linalg.vec3(0.0, 0.0, 5.0),
        linalg.vec3(0.0, 0.0, 0.0),
        linalg.vec3(0.0, 1.0, 0.0)
    );

    ptr := linalg.ptr4(&proj);

    ok := sum == linalg.vec3(5.0, 7.0, 9.0) &&
         diff == linalg.vec3(3.0, 3.0, 3.0) &&
         scaled == linalg.vec3(2.0, 4.0, 6.0) &&
         approx_eq(dot, 32.0, 0.0001) &&
         cross == linalg.vec3(-3.0, 6.0, -3.0) &&
         approx_eq(norm.x, 0.0, 0.0001) &&
         approx_eq(norm.y, 0.6, 0.0001) &&
         approx_eq(norm.z, 0.8, 0.0001) &&
         p == linalg.vec3(4.0, 4.0, 6.0) &&
         dir == linalg.vec3(2.0, 0.0, 0.0) &&
         approx_eq(rotated.x, 0.0, 0.0001) &&
         approx_eq(rotated.z, -1.0, 0.0001) &&
         ptr != @as(*f32, 0) &&
         view != linalg.identity4() &&
         proj != linalg.identity4();

    if(ok) {
        return 0;
    }
    return 1;
};
