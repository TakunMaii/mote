@package("std_filesystem_directory_api");

fs :: @import("std:filesystem");
mem :: @import("std:mem");

main :: fn() i32 {
    dir_path: *char = "test/artifacts/std_filesystem_directory_api";
    file_a: *char = "test/artifacts/std_filesystem_directory_api/a.txt";
    file_b: *char = "test/artifacts/std_filesystem_directory_api/b.txt";
    content_storage: Array(u8, 2) = ['o', 'k'];
    content: []u8 = @slice(u8, &content_storage[0], 2);

    fs.remove_file(file_a);
    fs.remove_file(file_b);
    fs.remove_directory(dir_path);

    if(!fs.create_directory(dir_path)) {
        return 1;
    }

    if(!fs.write_all(file_a, content) || !fs.write_all(file_b, content)) {
        fs.remove_file(file_a);
        fs.remove_file(file_b);
        fs.remove_directory(dir_path);
        return 2;
    }

    maybe_count: ?i64 = fs.directory_entry_count(dir_path);
    if(maybe_count == null || @unwrap(maybe_count) != 2) {
        fs.remove_file(file_a);
        fs.remove_file(file_b);
        fs.remove_directory(dir_path);
        return 3;
    }

    maybe_names: ?[]char = fs.list_directory_names(dir_path);
    if(maybe_names == null) {
        fs.remove_file(file_a);
        fs.remove_file(file_b);
        fs.remove_directory(dir_path);
        return 4;
    }

    names: []char = @unwrap(maybe_names);
    if(@len(names) == 0) {
        mem.free_slice(char, names);
        fs.remove_file(file_a);
        fs.remove_file(file_b);
        fs.remove_directory(dir_path);
        return 5;
    }

    saw_a: bool = false;
    saw_b: bool = false;
    i: i64 = 0;
    while(i < @len(names)) {
        if(i + 6 <= @len(names) &&
           names[i] == 'a' &&
           names[i + 1] == '.' &&
           names[i + 2] == 't' &&
           names[i + 3] == 'x' &&
           names[i + 4] == 't' &&
           names[i + 5] == '\0') {
            saw_a = true;
        }
        if(i + 6 <= @len(names) &&
           names[i] == 'b' &&
           names[i + 1] == '.' &&
           names[i + 2] == 't' &&
           names[i + 3] == 'x' &&
           names[i + 4] == 't' &&
           names[i + 5] == '\0') {
            saw_b = true;
        }
        i = i + 1;
    }

    mem.free_slice(char, names);
    fs.remove_file(file_a);
    fs.remove_file(file_b);
    if(!fs.remove_directory(dir_path)) {
        return 6;
    }
    if(!saw_a || !saw_b) {
        return 7;
    }
    return 0;
};