// 声明一个结构体类型和声明变量、声明函数在语法上是很接近的（相当于把结构体类型看作一个表达式）
// 这个做法和zig比较像
Vec2 :: struct {
    x: f32,
    y: f32,

    new: fn(x: i32, y: i32) Vec2 {
        return Vec2{
            .x = x,
            .y = y,//逗号可选
        };
    },

    // Self关键字代表本类型，第一个参数是Self, &Self, *Self的时候，调用成员函数时会自动填充
    add: fn(self: &Self, other: Vec2) void {
        self.x = self.x + other.x;
        self.y = self.y + other.y;
    },//逗号是可选的
};

v1: Vec2 = Vec2 {.x = 0, .y = 0};
v2: Vec2 = Vec2.new(1,1);
v2.add(v1);

//另外结构体的指针调用成员时可以自动解指针
v2_ptr: *Vec2 = &v2;
v2_ptr.x = 2;
