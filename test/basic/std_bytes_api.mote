bytes :: @import("std:bytes");

to_u8 :: fn(ptr: *char, len: i64) []u8 {
    return @slice(u8, @as(*u8, ptr), len);
};

main :: fn() void {
    storage: Array(u8, 6) = [1, 2, 3, 4, 5, 0];
    data: []u8 = @slice(u8, &storage[0], 6);
    prefix: []u8 = @slice(u8, &storage[0], 2);
    suffix: []u8 = @slice(u8, &storage[3], 3);

    if(bytes.is_empty(data)) {
        return;
    }
    if(!bytes.starts_with(data, prefix)) {
        return;
    }
    if(!bytes.ends_with(data, suffix)) {
        return;
    }
    if(@unwrap(bytes.index_of_byte(data, 4)) != 3) {
        return;
    }

    needle_storage: Array(u8, 2) = [3, 4];
    needle: []u8 = @slice(u8, &needle_storage[0], 2);
    if(@unwrap(bytes.index_of_slice(data, needle)) != 2) {
        return;
    }

    dst_storage: Array(u8, 6) = [0, 0, 0, 0, 0, 0];
    dst: []u8 = @slice(u8, &dst_storage[0], 6);
    if(bytes.copy(dst, data) != 6) {
        return;
    }
    if(!bytes.equal(dst, data)) {
        return;
    }

    bytes.zero(dst);
    if(dst[0] != 0 || dst[5] != 0) {
        return;
    }

    bytes.fill(dst, 7);
    if(dst[0] != 7 || dst[5] != 7) {
        return;
    }

    empty: []u8 = @slice(u8, @as(*u8, 0), 0);
    if(!bytes.is_empty(empty)) {
        return;
    }
    if(@unwrap(bytes.index_of_byte(data, 0)) != 5) {
        return;
    }

    embedded_needle_storage: Array(u8, 2) = [5, 0];
    embedded_needle: []u8 = @slice(u8, &embedded_needle_storage[0], 2);
    if(@unwrap(bytes.index_of_slice(data, embedded_needle)) != 4) {
        return;
    }
    if(bytes.index_of_slice(data, empty) == null || @unwrap(bytes.index_of_slice(data, empty)) != 0) {
        return;
    }

    sink := 1;
};