types :: @import("std:types");

main :: fn() i32 {
    if(@sizeof(types.byte) != 1) {
        return 1;
    }
    if(@sizeof(types.usize) != @sizeof(i64)) {
        return 4;
    }
    if(@alignof(types.usize) != @alignof(i64)) {
        return 5;
    }
    if(@sizeof(types.isize) != @sizeof(i64)) {
        return 6;
    }
    if(@sizeof(types.size_t) != @sizeof(i64)) {
        return 2;
    }
    if(@alignof(types.size_t) != @alignof(i64)) {
        return 3;
    }
    return 0;
};