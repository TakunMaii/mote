Vec2 = struct {
    x: f32,
    y: f32,
};

take_f32 = fn(x: f32) f32 {
    return x;
};

sum_f32 = fn(base: i32) f32 {
    return base + 0.5;
};

main = fn() i32 {
    base: i32 = 2;
    scalar: f32 = base + 0.5;
    point: Vec2 = Vec2 {
        .x = 1 + 2.5,
        .y = base + 1.25,
    };
    values: Array(f32, 3) = [
        1 + 2.5,
        base + 0.25,
        take_f32(2 + 3.5),
    ];
    returned: f32 = sum_f32(base);

    if(scalar == 2.5 &&
       point.x == 3.5 &&
       point.y == 3.25 &&
       values[0] == 3.5 &&
       values[1] == 2.25 &&
       values[2] == 5.5 &&
       returned == 2.5) {
        return 0;
    }
    return 1;
};
