ctype :: @import("std:ctype");
math :: @import("std:math");

approx_eq_f32 :: fn(a: f32, b: f32, eps: f32) bool {
    return math.abs_f32(a - b) <= eps;
};

approx_eq_f64 :: fn(a: f64, b: f64, eps: f64) bool {
    return math.abs_f64(a - b) <= eps;
};

main :: fn() void {
    digit_ok := ctype.is_digit('7') != 0;

    sqrt_ok := math.sqrt_f32(9.0) == 3.0 && math.sqrt_f64(16.0) == 4.0;
    minmax_ok := math.min_f32(2.0, 5.0) == 2.0 &&
                math.max_f32(2.0, 5.0) == 5.0 &&
                math.min_f64(2.0, 5.0) == 2.0 &&
                math.max_f64(2.0, 5.0) == 5.0;
    abs_ok := math.abs_f32(-3.5) == 3.5 &&
             math.abs_f64(-7.25) == 7.25;
    clamp_ok := math.clamp(i32, 15, 0, 10) == 10 &&
               math.clamp_f32(-1.0, 0.0, 1.0) == 0.0 &&
               math.clamp_f64(2.0, 0.0, 1.0) == 1.0;
    trig_ok := approx_eq_f32(math.sin_f32(math.PI_F32 / 2.0), 1.0, 0.0001) &&
              approx_eq_f32(math.cos_f32(0.0), 1.0, 0.0001) &&
              approx_eq_f64(math.sin_f64(math.PI_F64 / 2.0), 1.0, 0.0000001) &&
              approx_eq_f64(math.cos_f64(0.0), 1.0, 0.0000001);
    angle_ok := approx_eq_f32(math.deg_to_rad_f32(180.0), math.PI_F32, 0.0001) &&
               approx_eq_f32(math.rad_to_deg_f32(math.PI_F32), 180.0, 0.0001) &&
               approx_eq_f64(math.deg_to_rad_f64(180.0), math.PI_F64, 0.0000001) &&
               approx_eq_f64(math.rad_to_deg_f64(math.PI_F64), 180.0, 0.0000001);
    exp_log_ok := approx_eq_f32(math.pow_f32(2.0, 3.0), 8.0, 0.0001) &&
                 approx_eq_f32(math.log2_f32(8.0), 3.0, 0.0001) &&
                 approx_eq_f64(math.pow_f64(3.0, 2.0), 9.0, 0.0000001) &&
                 approx_eq_f64(math.log10_f64(1000.0), 3.0, 0.0000001);
    round_ok := math.floor_f32(3.75) == 3.0 &&
               math.ceil_f32(3.25) == 4.0 &&
               math.round_f32(3.5) == 4.0 &&
               math.trunc_f32(3.75) == 3.0 &&
               math.floor_f64(-3.25) == -4.0 &&
               math.ceil_f64(-3.75) == -3.0 &&
               math.trunc_f64(-3.75) == -3.0;
    lerp_ok := math.lerp_f32(10.0, 20.0, 0.25) == 12.5 &&
              math.lerp_f64(10.0, 20.0, 0.5) == 15.0;

    if(digit_ok && sqrt_ok && minmax_ok && abs_ok && clamp_ok &&
       trig_ok && angle_ok && exp_log_ok && round_ok && lerp_ok) {
        sink := 1;
    }
};
