Pair = struct {
    x: i32,
    ok: bool,
};

Color = enum {
    Red,
    Blue,
};

identity = fn(v: i32) i32 {
    return v;
};

mut numbers: Array(i32, 3) = [1, 2, 3];
pair = Pair{ .x = 7, .ok = true };
maybe: ?i32 = 42;
none: ?i32 = null;
slice = @slice(i32, &mut numbers[0], 3);
ptr = &mut numbers[1];
color: Color = Color.Blue;

@debug(123, true, 'Z');
@debug(numbers, slice);
@debug(pair, maybe, none, ptr);
@debug(color, identity, Pair, Color);
