std = @import("std");
map = @import("std/map");
set = @import("std/set");
hash = @import("std/hash");

main = fn() i32 {
    mut kv_map: map.Map(i32, i32) = std.map_init(i32, i32, hash.hash_i32, hash.eq_i32);
    mut i: i32 = 0;
    while(i < 32) {
        std.map_put(i32, i32, &mut kv_map, i, i * 10);
        i = i + 1;
    }

    mut ok: bool = true;
    i = 0;
    while(i < 32) {
        maybe_value: ?i32 = std.map_get(i32, i32, &kv_map, i);
        if(maybe_value == null || @unwrap(maybe_value) != i * 10) {
            ok = false;
        }
        i = i + 1;
    }

    mut removed_all_even: bool = true;
    i = 0;
    while(i < 32) {
        if(i % 2 == 0) {
            if(!std.map_remove(i32, i32, &mut kv_map, i)) {
                removed_all_even = false;
            }
        }
        i = i + 1;
    }

    mut set_value: set.Set(i32) = std.set_init(i32, hash.hash_i32, hash.eq_i32);
    i = 0;
    while(i < 32) {
        std.set_insert(i32, &mut set_value, i);
        i = i + 1;
    }

    mut set_ok: bool = true;
    i = 0;
    while(i < 32) {
        contains: bool = std.set_contains(i32, &set_value, i);
        if(!contains) {
            set_ok = false;
        }
        i = i + 1;
    }

    std.map_deinit(i32, i32, &mut kv_map);
    std.set_deinit(i32, &mut set_value);

    if(ok && removed_all_even && set_ok) {
        return 0;
    }
    return 1;
};
