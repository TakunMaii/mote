map = @import("std:map");
set = @import("std:set");
hash = @import("std:hash");

main = fn() i32 {
    mut kv_map: map.Map(i32, i32) = map.init(i32, i32, hash.hash_i32, hash.eq_i32);
    mut i: i32 = 0;
    while(i < 32) {
        kv_map.put(i, i * 10);
        i = i + 1;
    }

    mut ok: bool = true;
    i = 0;
    while(i < 32) {
        maybe_value: ?i32 = kv_map.get(i);
        if(maybe_value == null || @unwrap(maybe_value) != i * 10) {
            ok = false;
        }
        i = i + 1;
    }

    mut removed_all_even: bool = true;
    i = 0;
    while(i < 32) {
        if(i % 2 == 0) {
            if(!kv_map.remove(i)) {
                removed_all_even = false;
            }
        }
        i = i + 1;
    }

    mut set_value: set.Set(i32) = set.init(i32, hash.hash_i32, hash.eq_i32);
    i = 0;
    while(i < 32) {
        set_value.insert(i);
        i = i + 1;
    }

    mut set_ok: bool = true;
    i = 0;
    while(i < 32) {
        contains: bool = set_value.contains(i);
        if(!contains) {
            set_ok = false;
        }
        i = i + 1;
    }

    kv_map.deinit();
    set_value.deinit();

    if(ok && removed_all_even && set_ok) {
        return 0;
    }
    return 1;
};
