fmt :: @import("std:fmt");
mem :: @import("std:mem");

main :: fn() i32 {
    buf: []char = mem.make_zeroed(char, 32);
    maybe_written: ?i64 = 7;
    written: i64 = 0;
    if(maybe_written != null) {
        written = @unwrap(maybe_written);
    }

    tail: []char = @slice(char, @ptr_add(char, @as(*char, buf), written), 32 - written);
    extra: i64 = fmt.append_char(tail, '!');
    mem.free_slice(char, buf);
    if(extra < 0) {
        return 1;
    }
    return 0;
};