time = @import("std:time");

main = fn() i32 {
    if(time.ticks_per_second() != 1000000000) {
        return 4;
    }

    tick0: u64 = time.now_ticks();
    start: time.Instant = time.now();
    time.sleep_ms(1);
    finish: time.Instant = time.now();
    tick1: u64 = time.now_ticks();
    elapsed: time.Duration = time.elapsed_since(start, finish);

    if(time.as_ns(elapsed) == 0) {
        return 1;
    }
    if(time.as_ms(time.duration_seconds(2)) != 2000) {
        return 2;
    }
    if(time.as_us(time.duration_ms(3)) != 3000) {
        return 3;
    }
    if(tick1 < tick0) {
        return 5;
    }
    if(time.as_seconds(time.duration_ns(1999999999)) != 1) {
        return 6;
    }
    return 0;
};
