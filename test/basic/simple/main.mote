@package("simple");

main :: fn() i32 {
    x := 2;
    x = 2 - (3 + 2 * 5);

    flag := true;
    flag = false || true && !false;
    x = +1 + -2 * ~3;
    x = x % 3;
    flag = x < 10 || x <= 10 || x > 1 || x >= 1;
    flag = x == 2 || x != 3;
    x = x << 1 >> 2;
    x = x & 3 | 4 ^ 5;

    if(flag) {
        return x;
    }
    return 0;
};