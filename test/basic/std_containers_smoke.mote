list :: @import("std:list");
map :: @import("std:map");
set :: @import("std:set");
hash :: @import("std:hash");
mem :: @import("std:mem");

main :: fn() i32 {
    list_value: list.List(i32) = list.init(i32);
    list_value.append(10);
    list_value.append(20);
    list_value.insert(1, 15);
    removed: i32 = list_value.remove_at(0);
    popped: i32 = @unwrap(list_value.pop());

    arena: mem.Arena = mem.arena_init(256);
    defer mem.arena_destroy(&arena);

    arena_list: list.List(i32) = list.init_in_arena(i32, arena);
    arena_list.append(1);
    arena_list.append(2);
    arena_list.append(3);

    kv_map: map.Map(i32, i32) = map.init_cap(i32, i32, 8, hash.hash_i32, hash.eq_i32);
    kv_map.put(3, 30);
    kv_map.put(5, 50);
    kv_map.put(3, 31);
    kv_map.remove(5);

    set_value: set.Set(i32) = set.init_cap(i32, 8, hash.hash_i32, hash.eq_i32);
    set_value.insert(4);
    set_value.insert(8);
    set_value.remove(4);

    ok := removed == 10 &&
         popped == 20 &&
         list_value.len == 1 &&
         list_value.get(0) == 15 &&
         @len(arena_list.as_slice()) == 3 &&
         @unwrap(kv_map.get(3)) == 31 &&
         !kv_map.contains(5) &&
         set_value.contains(8) &&
         !set_value.contains(4);

    list_value.deinit();
    kv_map.deinit();
    set_value.deinit();

    if(ok) {
        return 0;
    }
    return 1;
};
