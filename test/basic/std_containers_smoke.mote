std = @import("std");
list = @import("std:list");
map = @import("std:map");
set = @import("std:set");
hash = @import("std:hash");
mem = @import("std:mem");

main = fn() i32 {
    mut list_value: list.List(i32) = list.init(i32);
    std.list_append(i32, &mut list_value, 10);
    std.list_append(i32, &mut list_value, 20);
    std.list_insert(i32, &mut list_value, 1, 15);
    removed: i32 = std.list_remove_at(i32, &mut list_value, 0);
    popped: i32 = @unwrap(std.list_pop(i32, &mut list_value));

    mut arena: mem.Arena = mem.arena_init(256);
    defer mem.arena_destroy(&mut arena);

    mut arena_list: list.List(i32) = list.init_in_arena(i32, arena);
    std.list_append(i32, &mut arena_list, 1);
    std.list_append(i32, &mut arena_list, 2);
    std.list_append(i32, &mut arena_list, 3);

    mut kv_map: map.Map(i32, i32) = map.init_cap(i32, i32, 8, hash.hash_i32, hash.eq_i32);
    std.map_put(i32, i32, &mut kv_map, 3, 30);
    std.map_put(i32, i32, &mut kv_map, 5, 50);
    std.map_put(i32, i32, &mut kv_map, 3, 31);
    std.map_remove(i32, i32, &mut kv_map, 5);

    mut set_value: set.Set(i32) = set.init_cap(i32, 8, hash.hash_i32, hash.eq_i32);
    std.set_insert(i32, &mut set_value, 4);
    std.set_insert(i32, &mut set_value, 8);
    std.set_remove(i32, &mut set_value, 4);

    ok = removed == 10 &&
         popped == 20 &&
         list_value.len == 1 &&
         std.list_get(i32, &list_value, 0) == 15 &&
         @len(std.list_as_slice(i32, &arena_list)) == 3 &&
         @unwrap(std.map_get(i32, i32, &kv_map, 3)) == 31 &&
         !std.map_contains(i32, i32, &kv_map, 5) &&
         std.set_contains(i32, &set_value, 8) &&
         !std.set_contains(i32, &set_value, 4);

    std.list_deinit(i32, &mut list_value);
    std.map_deinit(i32, i32, &mut kv_map);
    std.set_deinit(i32, &mut set_value);

    if(ok) {
        return 0;
    }
    return 1;
};
