list = @import("std:list");
map = @import("std:map");
set = @import("std:set");
hash = @import("std:hash");
mem = @import("std:mem");

main = fn() i32 {
    mut list_value: list.List(i32) = list.init(i32);
    list.append(i32, &mut list_value, 10);
    list.append(i32, &mut list_value, 20);
    list.insert(i32, &mut list_value, 1, 15);
    removed: i32 = list.remove_at(i32, &mut list_value, 0);
    popped: i32 = @unwrap(list.pop(i32, &mut list_value));

    mut arena: mem.Arena = mem.arena_init(256);
    defer mem.arena_destroy(&mut arena);

    mut arena_list: list.List(i32) = list.init_in_arena(i32, arena);
    list.append(i32, &mut arena_list, 1);
    list.append(i32, &mut arena_list, 2);
    list.append(i32, &mut arena_list, 3);

    mut kv_map: map.Map(i32, i32) = map.init_cap(i32, i32, 8, hash.hash_i32, hash.eq_i32);
    map.put(i32, i32, &mut kv_map, 3, 30);
    map.put(i32, i32, &mut kv_map, 5, 50);
    map.put(i32, i32, &mut kv_map, 3, 31);
    map.remove(i32, i32, &mut kv_map, 5);

    mut set_value: set.Set(i32) = set.init_cap(i32, 8, hash.hash_i32, hash.eq_i32);
    set.insert(i32, &mut set_value, 4);
    set.insert(i32, &mut set_value, 8);
    set.remove(i32, &mut set_value, 4);

    ok = removed == 10 &&
         popped == 20 &&
         list_value.len == 1 &&
         list.get(i32, &list_value, 0) == 15 &&
         @len(list.as_slice(i32, &arena_list)) == 3 &&
         @unwrap(map.get(i32, i32, &kv_map, 3)) == 31 &&
         !map.contains(i32, i32, &kv_map, 5) &&
         set.contains(i32, &set_value, 8) &&
         !set.contains(i32, &set_value, 4);

    list.deinit(i32, &mut list_value);
    map.deinit(i32, i32, &mut kv_map);
    set.deinit(i32, &mut set_value);

    if(ok) {
        return 0;
    }
    return 1;
};
