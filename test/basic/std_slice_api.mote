slice :: @import("std:slice");

main :: fn() void {
    values: Array(i32, 5) = [1, 2, 3, 4, 5];
    xs: []i32 = @slice(i32, &values[0], 5);

    if(slice.is_empty(i32, xs)) {
        return;
    }

    if(@unwrap(slice.first(i32, xs)) != 1) {
        return;
    }

    if(@unwrap(slice.last(i32, xs)) != 5) {
        return;
    }
    if(@unwrap(slice.get(i32, xs, 2)) != 3) {
        return;
    }

    third_ptr: ?*i32 = slice.get_ptr(i32, xs, 2);
    if(third_ptr == null) {
        return;
    }
    *(@unwrap(third_ptr)) = 30;
    if(values[2] != 30) {
        return;
    }

    first_two: []i32 = slice.head(i32, xs, 2);
    last_two: []i32 = slice.tail(i32, xs, 2);
    middle: []i32 = slice.subslice(i32, xs, 1, 3);

    if(@len(first_two) != 2 || first_two[0] != 1 || first_two[1] != 2) {
        return;
    }
    if(@len(last_two) != 2 || last_two[0] != 4 || last_two[1] != 5) {
        return;
    }
    if(@len(middle) != 3 || middle[0] != 2 || middle[2] != 4) {
        return;
    }

    if(!slice.starts_with(i32, xs, first_two)) {
        return;
    }
    if(!slice.ends_with(i32, xs, last_two)) {
        return;
    }
    if(@unwrap(slice.index_of(i32, xs, 30)) != 2) {
        return;
    }

    copied_buf: Array(i32, 3) = [0, 0, 0];
    copied: []i32 = @slice(i32, &copied_buf[0], 3);
    if(slice.copy(i32, copied, xs) != 3) {
        return;
    }
    if(copied[0] != 1 || copied[2] != 3) {
        return;
    }

    singleton: []i32 = @slice(i32, &values[0], 1);
    if(@unwrap(slice.first(i32, singleton)) != 1 || @unwrap(slice.last(i32, singleton)) != 1) {
        return;
    }

    out_of_bounds: ?i32 = slice.get(i32, xs, 99);
    if(out_of_bounds != null) {
        return;
    }

    overlap_storage: Array(i32, 5) = [1, 2, 3, 4, 5];
    overlap_src: []i32 = @slice(i32, &overlap_storage[0], 4);
    overlap_dst: []i32 = @slice(i32, &overlap_storage[1], 4);
    if(slice.copy(i32, overlap_dst, overlap_src) != 4) {
        return;
    }
    if(overlap_storage[0] != 1 || overlap_storage[1] != 1 || overlap_storage[2] != 2 || overlap_storage[3] != 3 || overlap_storage[4] != 4) {
        return;
    }

    slice.fill(i32, copied, 9);
    if(copied[0] != 9 || copied[2] != 9) {
        return;
    }

    slice.reverse(i32, xs);
    if(values[0] != 5 || values[4] != 1) {
        return;
    }

    empty: []i32 = @slice(i32, @as(*i32, 0), 0);
    if(slice.first(i32, empty) != null ||
       slice.last(i32, empty) != null ||
       slice.get(i32, empty, 0) != null ||
       slice.get_ptr(i32, empty, 0) != null) {
        return;
    }

    sink := 1;
};