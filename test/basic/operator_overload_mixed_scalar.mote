Vec3 = struct {
    x: f32,
    y: f32,
    z: f32,
};

@operator(*)
vec3_mul_f32 = fn(lhs: Vec3, rhs: f32) Vec3 {
    return Vec3{
        .x = lhs.x * rhs,
        .y = lhs.y * rhs,
        .z = lhs.z * rhs,
    };
};

main = fn() i32 {
    v = Vec3{ .x = 2.0, .y = 3.0, .z = 4.0 };
    out = v * 2;
    if(out.x == 4.0 && out.y == 6.0 && out.z == 8.0) {
        return 0;
    }
    return 1;
};
