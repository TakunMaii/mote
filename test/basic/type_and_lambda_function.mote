// Type 是类型的类型，类型本身也是值。
// 因此泛型不是特殊语法，而是“接收 Type，返回 Type 或其它值”的普通函数。

Vec2 :: fn(T: Type) Type {
    return struct {
        x: T,
        y: T,

        // Self 表示当前正在构造的那个类型值
        new: fn(x: T, y: T) Self {
            return Self {
                .x = x,
                .y = y,
            };
        },
    };
};

a: Vec2(f32) = Vec2(f32).new(1.4, 2.3);
b: Vec2(i32) = Vec2(i32).new(1, 2);

// 因此 struct / enum 不应该被当成“特事特办”的声明语法，
// 它们本质上都是返回 Type 的表达式。
Pair :: struct {
    left: i32,
    right: i32,
};

State :: enum {
    idle,
    running,
};

// Function([args...], ret) 表示函数类型，它本身也是一个 Type 值。
Adder :: Function([i32, i32], i32);

// lambda 函数是值；原有的 fn(...) {...} 只是没有捕获的 lambda。
// |x| 是值捕获；以后还会有 |&x| 和 |&x|。
make_adder :: fn(x: i32) Function([i32], i32) {
    return fn|x|(y: i32) i32 {
        return x + y;
    };
};

add3: Function([i32], i32) = make_adder(3);
sum :: add3(4);

noop: Function([], void) = fn() void {
};

// 函数的泛型可以通过柯里化表达。
add :: fn(T: Type) Function([T, T], T) {
    return fn|T|(x: T, y: T) T {
        return x + y;
    };
};

res := add(i32)(3, 2);

// 参数列表中的参数类型不能依赖同一层前面的参数，下面这种写法非法：
// bad = fn(T: Type, a: T) void {};
