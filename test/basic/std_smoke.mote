std = @import("std");

main = fn() void {
    len_ok = std.string_len("abc") == 3;
    cmp_ok = std.string_compare("abc", "abd") < 0;
    cmp_n_ok = std.string_compare_n("abc", "abd", 2) == 0;
    atoi_ok = std.string_to_int("42") == 42;

    if(len_ok && cmp_ok && cmp_n_ok && atoi_ok) {
        std.io_put_char(@as(i32, 'O'));
        std.io_put_str("std ok");
    }
};
