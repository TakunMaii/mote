g :: @import("./support_factories");
list :: @import("std:list");
map :: @import("std:map");
hash :: @import("std:hash");
mem :: @import("std:mem");

main :: fn() i32 {
    arena: mem.Arena = mem.arena_init(256);
    defer mem.arena_destroy(&arena);

    xs: list.List(i32) = list.init_in_arena(i32, arena);
    xs.append(5);
    xs.append(7);

    table: map.Map(i32, list.List(i32)) = map.init_in_arena(i32, list.List(i32), arena, hash.hash_i32, hash.eq_i32);
    table.put(1, xs);

    maybe_list: ?list.List(i32) = table.get(1);
    if(maybe_list == null) {
        return 1;
    }

    stored: list.List(i32) = @unwrap(maybe_list);
    second: i32 = stored.get(1);
    if(second == 7 && g.id(i64, stored.len) == 2) {
        return 0;
    }
    return 1;
};
