list :: @import("std:list");
map :: @import("std:map");
set :: @import("std:set");
hash :: @import("std:hash");

main :: fn() i32 {
    xs := list.init(i32);
    list.append(i32, &xs, 1);
    list.append(i32, &xs, 2);

    table := map.init(i32, i32, hash.hash_i32, hash.eq_i32);
    map.put(i32, i32, &table, 7, 70);

    seen := set.init(i32, hash.hash_i32, hash.eq_i32);
    set.insert(i32, &seen, 9);

    ok := list.get(i32, &xs, 1) == 2 &&
         @unwrap(map.get(i32, i32, &table, 7)) == 70 &&
         set.contains(i32, &seen, 9);

    list.deinit(i32, &xs);
    map.deinit(i32, i32, &table);
    set.deinit(i32, &seen);

    if(ok) {
        return 0;
    }
    return 1;
};
