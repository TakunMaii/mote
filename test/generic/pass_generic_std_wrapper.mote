list = @import("std:list");
map = @import("std:map");
set = @import("std:set");
hash = @import("std:hash");

main = fn() i32 {
    mut xs = list.init(i32);
    xs.append(1);
    xs.append(2);

    mut table = map.init(i32, i32, hash.hash_i32, hash.eq_i32);
    table.put(7, 70);

    mut seen = set.init(i32, hash.hash_i32, hash.eq_i32);
    seen.insert(9);

    ok = xs.get(1) == 2 &&
         @unwrap(table.get(7)) == 70 &&
         seen.contains(9);

    xs.deinit();
    table.deinit();
    seen.deinit();

    if(ok) {
        return 0;
    }
    return 1;
};
