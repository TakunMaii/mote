w = @import("./support_wrappers");

main = fn() i32 {
    mut values: Array(i32, 2) = [9, 12];
    xs: []i32 = @slice(i32, &mut values[0], 2);
    maybe_value: ?i32 = w.first_or_null_wrap(i32, xs);
    pair = w.pair_wrap(i32, 5, 6);
    copied: i32 = w.id_wrap(i32, pair.right);

    if(maybe_value != null && @unwrap(maybe_value) == 9 && copied == 6) {
        return 0;
    }
    return 1;
};
