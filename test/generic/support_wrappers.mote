base :: @import("./support_factories");

pub id_wrap :: fn(T: Type, value: T) T {
    return base.id(T, value);
};

pub pair_wrap :: fn(T: Type, left: T, right: T) base.Pair(T) {
    return base.make_pair(T, left, right);
};

pub first_or_null_wrap :: fn(T: Type, xs: []T) ?T {
    return base.first_or_null(T, xs);
};