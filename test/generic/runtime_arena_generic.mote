g = @import("./support_factories");
list = @import("std:list");
mem = @import("std:mem");

main = fn() i32 {
    mut arena: mem.Arena = mem.arena_init(128);
    defer mem.arena_destroy(&mut arena);

    mut xs = list.init_in_arena(i32, arena);
    list.append(i32, &mut xs, 9);
    list.append(i32, &mut xs, 10);

    maybe_value: ?i32 = g.first_or_null(i32, list.as_slice(i32, &xs));
    if(maybe_value != null && @unwrap(maybe_value) == 9) {
        return 0;
    }
    return 1;
};
