g :: @import("./support_factories");

main :: fn() i32 {
    base: g.Pair(i32) = g.make_pair(i32, 1, 2);
    flipped: g.Pair(i32) = g.flip_pair(i32, base);
    changed: g.Pair(i32) = base;
    g.replace_pair_left(i32, &changed, 7);
    floats: g.Pair(f32) = g.make_pair(f32, 1.5, 2.5);

    if(flipped.left == 2 &&
       flipped.right == 1 &&
       changed.left == 7 &&
       floats.right > 2.0) {
        return 0;
    }
    return 1;
};