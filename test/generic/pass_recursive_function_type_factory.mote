Node :: fn(T: Type) Type {
    return struct {
        visit: Function([Node(T)], i32),
        value: T,
    };
};

visit_i32 :: fn(node: Node(i32)) i32 {
    return node.value;
};

main :: fn() i32 {
    local_visit: Function([Node(i32)], i32) = fn(node: Node(i32)) i32 {
        return node.value;
    };
    root: Node(i32) = Node(i32) {
        .visit = local_visit,
        .value = 9,
    };
    if(local_visit(root) == 9 && root.value == 9) {
        return 0;
    }
    return 1;
};