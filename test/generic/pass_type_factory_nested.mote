g = @import("./support_factories");

main = fn() i32 {
    inner: g.Pair(i32) = g.make_pair(i32, 3, 4);
    outer: g.Box(g.Pair(i32)) = g.make_box(g.Pair(i32), inner);
    extracted: g.Pair(i32) = g.box_get(g.Pair(i32), outer);
    mut changed: g.Box(g.Pair(i32)) = outer;
    g.box_set(g.Pair(i32), &mut changed, g.make_pair(i32, 8, 9));
    updated: g.Pair(i32) = g.box_get(g.Pair(i32), changed);

    if(extracted.left == 3 &&
       extracted.right == 4 &&
       updated.left == 8 &&
       updated.right == 9) {
        return 0;
    }
    return 1;
};
