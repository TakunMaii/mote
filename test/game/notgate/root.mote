pub State = struct {
    map_width: i32,
    map_height: i32,
    current_level: i32,

    hero_x: i32,
    hero_y: i32,

    static_tiles: Array(i32, 345),
    dynamic_types: Array(i32, 345),
    static_activated: Array(bool, 345),
    dynamic_activated: Array(bool, 345),

    undo_count: i32,
    undo_states: Array(UndoState, 256),

    command_visible: bool,
    command_len: i32,
    command_buffer: Array(char, 32),

    hint_len: i32,
    hint_buffer: Array(char, 64),
    hint_timer: f32,

    particle_spawn_timer: f32,
    particle_count: i32,
    particles: Array(Particle, 100),
};

mut runtime_state: State = @zero(State);
mut game_resources: GameResources = @zero(GameResources);

pub abs_i32 = fn(x: i32) i32 {
    if(x < 0) {
        return -x;
    }
    return x;
};

pub min_i32 = fn(a: i32, b: i32) i32 {
    if(a < b) {
        return a;
    }
    return b;
};

pub randf = fn(min_v: f32, max_v: f32) f32 {
    mut t: f32 = rl.GetRandomValue(0, 10000);
    t = t / 10000;
    return min_v + (max_v - min_v) * t;
};

pub random_0_1 = fn() f32 {
    return randf(0.0, 1.0);
};

pub boundary_offset_x = fn(index: i32) i32 {
    if(index == 0) {
        return 0;
    } else if(index == 1) {
        return 1;
    } else if(index == 2) {
        return 2;
    } else if(index == 3) {
        return 3;
    } else if(index == 4) {
        return 2;
    } else if(index == 5) {
        return 1;
    } else if(index == 6) {
        return 0;
    } else if(index == 7) {
        return -1;
    } else if(index == 8) {
        return -2;
    } else if(index == 9) {
        return -3;
    } else if(index == 10) {
        return -2;
    }
    return -1;
};

pub boundary_offset_y = fn(index: i32) i32 {
    if(index == 0) {
        return 3;
    } else if(index == 1) {
        return 2;
    } else if(index == 2) {
        return 1;
    } else if(index == 3) {
        return 0;
    } else if(index == 4) {
        return -1;
    } else if(index == 5) {
        return -2;
    } else if(index == 6) {
        return -3;
    } else if(index == 7) {
        return -2;
    } else if(index == 8) {
        return -1;
    } else if(index == 9) {
        return 0;
    } else if(index == 10) {
        return 1;
    }
    return 2;
};

pub map_index = fn(state: &State, x: i32, y: i32) i32 {
    return y * state.map_width + x;
};

pub map_in_bounds = fn(state: &State, x: i32, y: i32) bool {
    return x >= 0 && x < state.map_width && y >= 0 && y < state.map_height;
};

pub clear_command = fn(state: &mut State) void {
    state.command_visible = false;
    state.command_len = 0;
    state.command_buffer[0] = '\0';
};

pub set_hint = fn(state: &mut State, src: *char, len: i32, timer: f32) void {
    mut copy_len: i32 = len;
    if(copy_len < 0) {
        copy_len = 0;
    }
    if(copy_len >= HINT_BUFFER_CAP) {
        copy_len = HINT_BUFFER_CAP - 1;
    }
    if(copy_len > 0) {
        c.memcpy(&state.hint_buffer[0], src, copy_len);
    }
    state.hint_buffer[copy_len] = '\0';
    state.hint_len = copy_len;
    state.hint_timer = timer;
};

pub reset_runtime_state = fn(state: &mut State) void {
    state.undo_count = 0;
    clear_command(state);
    state.hint_len = 0;
    state.hint_buffer[0] = '\0';
    state.hint_timer = 0.0;
    state.particle_spawn_timer = 0.0;
    state.particle_count = 0;
};

pub clear_map_arrays = fn(state: &mut State) void {
    c.memset(&state.static_tiles[0], 0, MAP_MAX_CELLS * 4);
    c.memset(&state.dynamic_types[0], 0, MAP_MAX_CELLS * 4);
    c.memset(&state.static_activated[0], 0, MAP_MAX_CELLS);
    c.memset(&state.dynamic_activated[0], 0, MAP_MAX_CELLS);
};

pub clear_undo_state = fn(snapshot: &mut UndoState) void {
    snapshot.hero_x = 0;
    snapshot.hero_y = 0;
    c.memset(&snapshot.dynamic_types[0], 0, MAP_MAX_CELLS * 4);
    c.memset(&snapshot.static_activated[0], 0, MAP_MAX_CELLS);
    c.memset(&snapshot.dynamic_activated[0], 0, MAP_MAX_CELLS);
};

pub init_empty_state = fn(state: &mut State) void {
    state.map_width = 0;
    state.map_height = 0;
    state.current_level = 0;
    state.hero_x = 0;
    state.hero_y = 0;
    clear_map_arrays(state);

    state.undo_count = 0;
    mut undo_idx: i32 = 0;
    while(undo_idx < UNDO_MAX) {
        clear_undo_state(state.undo_states[undo_idx]);
        undo_idx = undo_idx + 1;
    }

    state.command_visible = false;
    state.command_len = 0;
    c.memset(&state.command_buffer[0], 0, COMMAND_BUFFER_CAP);

    state.hint_len = 0;
    c.memset(&state.hint_buffer[0], 0, HINT_BUFFER_CAP);
    state.hint_timer = 0.0;
    state.particle_spawn_timer = 0.0;
    state.particle_count = 0;
};

pub level_path = fn(level: i32) CharBuf64 {
    mut out: CharBuf64 = @zero(CharBuf64);
    c.snprintf(&out.data[0], 64, @as(*char, "test/game/notgate/assets/maps/map%d.txt"), level);
    return out;
};

pub level_path_local = fn(level: i32) CharBuf64 {
    mut out: CharBuf64 = @zero(CharBuf64);
    c.snprintf(&out.data[0], 64, @as(*char, "game/notgate/assets/maps/map%d.txt"), level);
    return out;
};

pub level_path_parent = fn(level: i32) CharBuf64 {
    mut out: CharBuf64 = @zero(CharBuf64);
    c.snprintf(&out.data[0], 64, @as(*char, "assets/maps/map%d.txt"), level);
    return out;
};

pub asset_path = fn(path: *char) CharBuf128 {
    mut out: CharBuf128 = @zero(CharBuf128);
    c.snprintf(&out.data[0], 128, @as(*char, "test/game/notgate/%s"), path);
    if(rl.FileExists(&out.data[0])) {
        return out;
    }

    c.memset(&out.data[0], 0, 128);
    c.snprintf(&out.data[0], 128, @as(*char, "game/notgate/%s"), path);
    if(rl.FileExists(&out.data[0])) {
        return out;
    }

    c.memset(&out.data[0], 0, 128);
    c.snprintf(&out.data[0], 128, @as(*char, "%s"), path);
    if(rl.FileExists(&out.data[0])) {
        return out;
    }

    c.memset(&out.data[0], 0, 128);
    c.snprintf(&out.data[0], 128, @as(*char, "../game/notgate/%s"), path);
    if(rl.FileExists(&out.data[0])) {
        return out;
    }

    c.memset(&out.data[0], 0, 128);
    c.snprintf(&out.data[0], 128, @as(*char, "../../game/notgate/%s"), path);
    return out;
};

pub load_texture_asset = fn(path: *char) rl.Texture2D {
    mut full_path: CharBuf128 = asset_path(path);
    return rl.LoadTexture(&full_path.data[0]);
};

pub load_sound_asset = fn(path: *char) rl.Sound {
    mut full_path: CharBuf128 = asset_path(path);
    return rl.LoadSound(&full_path.data[0]);
};

pub load_music_asset = fn(path: *char) rl.Music {
    mut full_path: CharBuf128 = asset_path(path);
    return rl.LoadMusicStream(&full_path.data[0]);
};

pub load_shader_fragment_asset = fn(path: *char) rl.Shader {
    mut full_path: CharBuf128 = asset_path(path);
    null_path: *char = 0;
    return rl.LoadShader(null_path, &full_path.data[0]);
};

pub init_ambient_squares = fn() void {
    if(game_resources.ambient_ready) {
        return;
    }

    mut i: i32 = 0;
    while(i < AMBIENT_FLOATING_SQUARE_COUNT) {
        game_resources.ambient_squares[i] = FloatingSquare {
            .anchor = rl.Vector2 {
                .x = randf(24.0, @as(f32, WINDOW_WIDTH) - 24.0),
                .y = randf(24.0, @as(f32, WINDOW_HEIGHT) - 24.0),
            },
            .amp_x = randf(6.0, 24.0),
            .amp_y = randf(6.0, 24.0),
            .speed_x = randf(0.25, 0.65),
            .speed_y = randf(0.20, 0.55),
            .phase_x = randf(0.0, 6.28318),
            .phase_y = randf(0.0, 6.28318),
        };
        i = i + 1;
    }
    game_resources.ambient_ready = true;
    game_resources.ambient_time = 0.0;
};

pub init_audio_resources = fn() void {
    if(!rl.IsAudioDeviceReady()) {
        rl.InitAudioDevice();
    }

    if(!game_resources.sounds_loaded && rl.IsAudioDeviceReady()) {
        game_resources.sfx_active = load_sound_asset(@as(*char, "assets/sounds/active.wav"));
        game_resources.sfx_inactive = load_sound_asset(@as(*char, "assets/sounds/inactive.wav"));
        game_resources.sfx_move = load_sound_asset(@as(*char, "assets/sounds/move.wav"));
        game_resources.sfx_transport = load_sound_asset(@as(*char, "assets/sounds/transport.wav"));
        rl.SetSoundVolume(game_resources.sfx_active, SFX_ACTIVE_VOLUME);
        rl.SetSoundVolume(game_resources.sfx_inactive, SFX_INACTIVE_VOLUME);
        rl.SetSoundVolume(game_resources.sfx_move, SFX_MOVE_VOLUME);
        rl.SetSoundVolume(game_resources.sfx_transport, SFX_TRANSPORT_VOLUME);
        game_resources.sounds_loaded = true;
    }

    if(!game_resources.bgm_loaded && rl.IsAudioDeviceReady()) {
        mut full_path: CharBuf128 = asset_path(@as(*char, "assets/sounds/bgm.wav"));
        if(rl.FileExists(&full_path.data[0])) {
            game_resources.bgm = rl.LoadMusicStream(&full_path.data[0]);
            rl.SetMusicVolume(game_resources.bgm, BGM_VOLUME);
            rl.PlayMusicStream(game_resources.bgm);
            game_resources.bgm_loaded = true;
        }
    }
};

pub init_render_resources = fn() void {
    if(!game_resources.render_target_loaded) {
        game_resources.scene_target = rl.LoadRenderTexture(WINDOW_WIDTH, WINDOW_HEIGHT);
        rl.SetTextureFilter(game_resources.scene_target.texture, rl.TEXTURE_FILTER_BILINEAR);
        game_resources.render_target_loaded = true;
    }

    if(!game_resources.use_postprocess && game_resources.postprocess_shader.id == @as(u32, 0)) {
        game_resources.postprocess_shader = load_shader_fragment_asset(@as(*char, "assets/shaders/postprocess.fs"));
        if(game_resources.postprocess_shader.id != @as(u32, 0)) {
            game_resources.use_postprocess = true;
            game_resources.post_vignette_loc = rl.GetShaderLocation(game_resources.postprocess_shader, @as(*char, "uVignetteStrength"));
            game_resources.post_bloom_threshold_loc = rl.GetShaderLocation(game_resources.postprocess_shader, @as(*char, "uBloomThreshold"));
            game_resources.post_bloom_strength_loc = rl.GetShaderLocation(game_resources.postprocess_shader, @as(*char, "uBloomStrength"));

            vignette_strength: f32 = @as(f32, 0.35);
            bloom_threshold: f32 = @as(f32, 0.75);
            bloom_strength: f32 = @as(f32, 0.55);
            if(game_resources.post_vignette_loc >= 0) {
                rl.SetShaderValue(game_resources.postprocess_shader, game_resources.post_vignette_loc, &vignette_strength, rl.SHADER_UNIFORM_FLOAT);
            }
            if(game_resources.post_bloom_threshold_loc >= 0) {
                rl.SetShaderValue(game_resources.postprocess_shader, game_resources.post_bloom_threshold_loc, &bloom_threshold, rl.SHADER_UNIFORM_FLOAT);
            }
            if(game_resources.post_bloom_strength_loc >= 0) {
                rl.SetShaderValue(game_resources.postprocess_shader, game_resources.post_bloom_strength_loc, &bloom_strength, rl.SHADER_UNIFORM_FLOAT);
            }
        }
    }
};

pub init_visual_resources = fn() void {
    if(game_resources.wall_texture.id == @as(u32, 0)) {
        game_resources.wall_texture = load_texture_asset(@as(*char, "assets/art/wall.png"));
    }
    if(game_resources.box_texture.id == @as(u32, 0)) {
        game_resources.box_texture = load_texture_asset(@as(*char, "assets/art/box.png"));
    }
    if(game_resources.hero_texture.id == @as(u32, 0)) {
        game_resources.hero_texture = load_texture_asset(@as(*char, "assets/art/hero.png"));
    }
    if(game_resources.signal_source_texture.id == @as(u32, 0)) {
        game_resources.signal_source_texture = load_texture_asset(@as(*char, "assets/art/signal_source.png"));
    }
    if(game_resources.fixed_signal_source_texture.id == @as(u32, 0)) {
        game_resources.fixed_signal_source_texture = load_texture_asset(@as(*char, "assets/art/fixed_signal_source.png"));
    }
    if(game_resources.portal_inactive_texture.id == @as(u32, 0)) {
        game_resources.portal_inactive_texture = load_texture_asset(@as(*char, "assets/art/portal_inactive.png"));
    }
    if(game_resources.portal_active_texture.id == @as(u32, 0)) {
        game_resources.portal_active_texture = load_texture_asset(@as(*char, "assets/art/portal_active.png"));
    }
    if(game_resources.repeater_inactive_texture.id == @as(u32, 0)) {
        game_resources.repeater_inactive_texture = load_texture_asset(@as(*char, "assets/art/repeater_inactive.png"));
    }
    if(game_resources.repeater_active_texture.id == @as(u32, 0)) {
        game_resources.repeater_active_texture = load_texture_asset(@as(*char, "assets/art/repeater_active.png"));
    }
    if(game_resources.fixed_repeater_inactive_texture.id == @as(u32, 0)) {
        game_resources.fixed_repeater_inactive_texture = load_texture_asset(@as(*char, "assets/art/fixed_repeater_inactive.png"));
    }
    if(game_resources.fixed_repeater_active_texture.id == @as(u32, 0)) {
        game_resources.fixed_repeater_active_texture = load_texture_asset(@as(*char, "assets/art/fixed_repeater_active.png"));
    }
    if(game_resources.not_signal_inactive_texture.id == @as(u32, 0)) {
        game_resources.not_signal_inactive_texture = load_texture_asset(@as(*char, "assets/art/not_signal_inactive.png"));
    }
    if(game_resources.not_signal_active_texture.id == @as(u32, 0)) {
        game_resources.not_signal_active_texture = load_texture_asset(@as(*char, "assets/art/not_signal_active.png"));
    }
    if(game_resources.fixed_not_signal_inactive_texture.id == @as(u32, 0)) {
        game_resources.fixed_not_signal_inactive_texture = load_texture_asset(@as(*char, "assets/art/fixed_not_signal_inactive.png"));
    }
    if(game_resources.fixed_not_signal_active_texture.id == @as(u32, 0)) {
        game_resources.fixed_not_signal_active_texture = load_texture_asset(@as(*char, "assets/art/fixed_not_signal_active.png"));
    }
};

pub init_game_resources = fn() void {
    init_audio_resources();
    init_render_resources();
    init_visual_resources();
    init_ambient_squares();
};

pub unload_texture_if_loaded = fn(texture: rl.Texture2D) void {
    if(texture.id != @as(u32, 0)) {
        rl.UnloadTexture(texture);
    }
};

pub shutdown_game_resources = fn() void {
    if(game_resources.bgm_loaded) {
        rl.StopMusicStream(game_resources.bgm);
        rl.UnloadMusicStream(game_resources.bgm);
        game_resources.bgm_loaded = false;
    }

    if(game_resources.sounds_loaded) {
        rl.UnloadSound(game_resources.sfx_active);
        rl.UnloadSound(game_resources.sfx_inactive);
        rl.UnloadSound(game_resources.sfx_move);
        rl.UnloadSound(game_resources.sfx_transport);
        game_resources.sounds_loaded = false;
    }

    if(game_resources.use_postprocess) {
        rl.UnloadShader(game_resources.postprocess_shader);
        game_resources.use_postprocess = false;
    }

    if(game_resources.render_target_loaded) {
        rl.UnloadRenderTexture(game_resources.scene_target);
        game_resources.render_target_loaded = false;
    }

    unload_texture_if_loaded(game_resources.wall_texture);
    unload_texture_if_loaded(game_resources.box_texture);
    unload_texture_if_loaded(game_resources.hero_texture);
    unload_texture_if_loaded(game_resources.signal_source_texture);
    unload_texture_if_loaded(game_resources.fixed_signal_source_texture);
    unload_texture_if_loaded(game_resources.portal_inactive_texture);
    unload_texture_if_loaded(game_resources.portal_active_texture);
    unload_texture_if_loaded(game_resources.repeater_inactive_texture);
    unload_texture_if_loaded(game_resources.repeater_active_texture);
    unload_texture_if_loaded(game_resources.fixed_repeater_inactive_texture);
    unload_texture_if_loaded(game_resources.fixed_repeater_active_texture);
    unload_texture_if_loaded(game_resources.not_signal_inactive_texture);
    unload_texture_if_loaded(game_resources.not_signal_active_texture);
    unload_texture_if_loaded(game_resources.fixed_not_signal_inactive_texture);
    unload_texture_if_loaded(game_resources.fixed_not_signal_active_texture);

    if(rl.IsAudioDeviceReady()) {
        rl.CloseAudioDevice();
    }
};

pub play_sound_if_loaded = fn(sound: rl.Sound) void {
    if(game_resources.sounds_loaded) {
        rl.PlaySound(sound);
    }
};

pub open_level_file = fn(level: i32, mode: *char) *void {
    null_file: *void = 0;

    mut repo_path: CharBuf64 = level_path(level);
    mut file: *void = c.fopen(&repo_path.data[0], mode);
    if(file != null_file) {
        c.fputs(@as(*char, "open repo\n"), c.stderr_handle());
        return file;
    }

    mut local_path: CharBuf64 = level_path_local(level);
    file = c.fopen(&local_path.data[0], mode);
    if(file != null_file) {
        c.fputs(@as(*char, "open local\n"), c.stderr_handle());
        return file;
    }

    mut parent_path: CharBuf64 = level_path_parent(level);
    file = c.fopen(&parent_path.data[0], mode);
    if(file != null_file) {
        c.fputs(@as(*char, "open parent\n"), c.stderr_handle());
    }
    return file;
};

pub level_exists = fn(level: i32) bool {
    null_file: *void = 0;
    file: *void = open_level_file(level, @as(*char, "rb"));
    if(file == null_file) {
        return false;
    }
    c.fclose(file);
    return true;
};

pub static_is_walkable_for_hero = fn(tile: i32, activated: bool) bool {
    if(tile == STATIC_TILE_EMPTY) {
        return true;
    }
    if(tile == STATIC_TILE_PORTAL) {
        return activated;
    }
    return false;
};

pub static_is_activatable = fn(tile: i32) bool {
    return tile == STATIC_TILE_PORTAL
        || tile == STATIC_TILE_FIXED_REPEATER
        || tile == STATIC_TILE_FIXED_NOT_SIGNAL;
};

pub dynamic_is_activatable = fn(tile: i32) bool {
    return tile == DYNAMIC_TILE_REPEATER || tile == DYNAMIC_TILE_NOT_SIGNAL;
};

pub cell_has_not_signal = fn(state: &State, idx: i32) bool {
    return state.static_tiles[idx] == STATIC_TILE_FIXED_NOT_SIGNAL
        || state.dynamic_types[idx] == DYNAMIC_TILE_NOT_SIGNAL;
};

pub cell_can_emit_signal = fn(state: &State, idx: i32) bool {
    if(state.static_tiles[idx] == STATIC_TILE_FIXED_SIGNAL_SOURCE) {
        return true;
    }
    if(state.dynamic_types[idx] == DYNAMIC_TILE_SIGNAL_SOURCE) {
        return true;
    }
    if(state.static_tiles[idx] == STATIC_TILE_FIXED_REPEATER && state.static_activated[idx]) {
        return true;
    }
    if(state.dynamic_types[idx] == DYNAMIC_TILE_REPEATER && state.dynamic_activated[idx]) {
        return true;
    }
    if(state.static_tiles[idx] == STATIC_TILE_FIXED_NOT_SIGNAL && !state.static_activated[idx]) {
        return true;
    }
    if(state.dynamic_types[idx] == DYNAMIC_TILE_NOT_SIGNAL && !state.dynamic_activated[idx]) {
        return true;
    }
    return false;
};

pub try_push_chain = fn(state: &mut State, start_x: i32, start_y: i32, dx: i32, dy: i32) bool {
    mut cursor_x: i32 = start_x;
    mut cursor_y: i32 = start_y;
    if(!map_in_bounds(state, cursor_x, cursor_y)) {
        return false;
    }

    cursor_idx: i32 = map_index(state, cursor_x, cursor_y);
    if(state.dynamic_types[cursor_idx] == DYNAMIC_TILE_NONE) {
        return false;
    }

    while(map_in_bounds(state, cursor_x, cursor_y)
        && state.dynamic_types[map_index(state, cursor_x, cursor_y)] != DYNAMIC_TILE_NONE) {
        cursor_x = cursor_x + dx;
        cursor_y = cursor_y + dy;
    }

    if(!map_in_bounds(state, cursor_x, cursor_y)) {
        return false;
    }

    target_idx: i32 = map_index(state, cursor_x, cursor_y);
    if(state.static_tiles[target_idx] != STATIC_TILE_EMPTY) {
        return false;
    }

    mut x: i32 = cursor_x - dx;
    mut y: i32 = cursor_y - dy;
    while(x != start_x - dx || y != start_y - dy) {
        src_idx: i32 = map_index(state, x, y);
        dst_x: i32 = x + dx;
        dst_y: i32 = y + dy;
        dst_idx: i32 = map_index(state, dst_x, dst_y);

        state.dynamic_types[dst_idx] = state.dynamic_types[src_idx];
        state.dynamic_activated[dst_idx] = state.dynamic_activated[src_idx];
        if(state.dynamic_types[dst_idx] == DYNAMIC_TILE_NOT_SIGNAL) {
            state.dynamic_activated[dst_idx] = true;
        }
        state.dynamic_types[src_idx] = DYNAMIC_TILE_NONE;
        state.dynamic_activated[src_idx] = false;

        x = x - dx;
        y = y - dy;
    }

    return true;
};

pub recalculate_activation = fn(state: &mut State) void {
    cell_count: i32 = state.map_width * state.map_height;
    if(cell_count <= 0) {
        return;
    }

    mut scratch: ActivationScratch = @zero(ActivationScratch);

    mut idx: i32 = 0;
    while(idx < cell_count) {
        scratch.prev_static_activated[idx] = state.static_activated[idx];
        scratch.prev_dynamic_activated[idx] = state.dynamic_activated[idx];
        if(static_is_activatable(state.static_tiles[idx])) {
            state.static_activated[idx] = false;
        }
        if(dynamic_is_activatable(state.dynamic_types[idx])) {
            state.dynamic_activated[idx] = false;
        }
        scratch.component_id[idx] = -1;
        idx = idx + 1;
    }

    mut q_head: i32 = 0;
    mut q_tail: i32 = 0;
    mut y: i32 = 0;
    while(y < state.map_height) {
        mut x: i32 = 0;
        while(x < state.map_width) {
            idx = map_index(state, x, y);
            if(state.static_tiles[idx] == STATIC_TILE_FIXED_SIGNAL_SOURCE
                || state.dynamic_types[idx] == DYNAMIC_TILE_SIGNAL_SOURCE) {
                if(!scratch.const_emitter[idx]) {
                    scratch.const_emitter[idx] = true;
                    scratch.queue[q_tail] = idx;
                    q_tail = q_tail + 1;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }

    while(q_head < q_tail) {
        emitter_idx: i32 = scratch.queue[q_head];
        q_head = q_head + 1;
        ex: i32 = emitter_idx % state.map_width;
        ey: i32 = emitter_idx / state.map_width;

        mut dy: i32 = -3;
        while(dy <= 3) {
            max_abs_dx: i32 = 3 - abs_i32(dy);
            mut dx: i32 = -max_abs_dx;
            while(dx <= max_abs_dx) {
                tx: i32 = ex + dx;
                ty: i32 = ey + dy;
                if(map_in_bounds(state, tx, ty)) {
                    idx = map_index(state, tx, ty);
                    if(state.static_tiles[idx] == STATIC_TILE_PORTAL) {
                        state.static_activated[idx] = true;
                    }
                    if(state.static_tiles[idx] == STATIC_TILE_FIXED_REPEATER && !scratch.const_emitter[idx]) {
                        scratch.const_emitter[idx] = true;
                        scratch.queue[q_tail] = idx;
                        q_tail = q_tail + 1;
                    }
                    if(state.dynamic_types[idx] == DYNAMIC_TILE_REPEATER && !scratch.const_emitter[idx]) {
                        scratch.const_emitter[idx] = true;
                        scratch.queue[q_tail] = idx;
                        q_tail = q_tail + 1;
                    }
                    if(cell_has_not_signal(state, idx)) {
                        scratch.const_hits_not[idx] = true;
                    }
                }
                dx = dx + 1;
            }
            dy = dy + 1;
        }
    }

    mut component_count: i32 = 0;
    idx = 0;
    while(idx < cell_count) {
        if(!cell_has_not_signal(state, idx) || scratch.component_id[idx] >= 0) {
            idx = idx + 1;
            continue;
        }

        mut local_head: i32 = 0;
        mut local_tail: i32 = 0;
        scratch.queue[local_tail] = idx;
        local_tail = local_tail + 1;
        scratch.component_id[idx] = component_count;

        while(local_head < local_tail) {
            current: i32 = scratch.queue[local_head];
            local_head = local_head + 1;
            cx: i32 = current % state.map_width;
            cy: i32 = current / state.map_width;
            scratch.component_size[component_count] = scratch.component_size[component_count] + 1;
            if(scratch.const_hits_not[current]) {
                scratch.component_hit_count[component_count] = scratch.component_hit_count[component_count] + 1;
            }

            mut other: i32 = 0;
            while(other < cell_count) {
                if(scratch.component_id[other] < 0 && cell_has_not_signal(state, other)) {
                    ox: i32 = other % state.map_width;
                    oy: i32 = other / state.map_width;
                    if(abs_i32(cx - ox) + abs_i32(cy - oy) <= 3) {
                        scratch.component_id[other] = component_count;
                        scratch.queue[local_tail] = other;
                        local_tail = local_tail + 1;
                    }
                }
                other = other + 1;
            }
        }

        component_count = component_count + 1;
        idx = idx + 1;
    }

    idx = 0;
    while(idx < cell_count) {
        if(cell_has_not_signal(state, idx)) {
            cid: i32 = scratch.component_id[idx];
            if(cid >= 0) {
                size: i32 = scratch.component_size[cid];
                hits: i32 = scratch.component_hit_count[cid];
                hit: bool = scratch.const_hits_not[idx];
                if(size <= 1) {
                    scratch.force_not_off[idx] = hit;
                } else if(hits > 0 && hits < size) {
                    scratch.force_not_off[idx] = hit;
                } else {
                    scratch.force_not_off[idx] = false;
                }
            }
        }
        idx = idx + 1;
    }

    idx = 0;
    while(idx < cell_count) {
        has_static_repeater: bool = state.static_tiles[idx] == STATIC_TILE_FIXED_REPEATER;
        has_dynamic_repeater: bool = state.dynamic_types[idx] == DYNAMIC_TILE_REPEATER;
        has_static_not: bool = state.static_tiles[idx] == STATIC_TILE_FIXED_NOT_SIGNAL;
        has_dynamic_not: bool = state.dynamic_types[idx] == DYNAMIC_TILE_NOT_SIGNAL;
        has_signal: bool = state.static_tiles[idx] == STATIC_TILE_FIXED_SIGNAL_SOURCE
            || state.dynamic_types[idx] == DYNAMIC_TILE_SIGNAL_SOURCE;

        if(has_signal) {
            scratch.emit_curr[idx] = true;
            scratch.is_variable[idx] = false;
            idx = idx + 1;
            continue;
        }

        if(has_static_repeater || has_dynamic_repeater) {
            if(scratch.const_emitter[idx]) {
                scratch.emit_curr[idx] = true;
                scratch.is_variable[idx] = false;
            } else {
                if(has_static_repeater) {
                    scratch.emit_curr[idx] = scratch.prev_static_activated[idx];
                } else {
                    scratch.emit_curr[idx] = scratch.prev_dynamic_activated[idx];
                }
                scratch.is_variable[idx] = true;
            }
            idx = idx + 1;
            continue;
        }

        if(has_static_not || has_dynamic_not) {
            if(scratch.force_not_off[idx]) {
                scratch.emit_curr[idx] = false;
                scratch.is_variable[idx] = false;
            } else {
                if(has_static_not) {
                    scratch.emit_curr[idx] = !scratch.prev_static_activated[idx];
                } else {
                    scratch.emit_curr[idx] = !scratch.prev_dynamic_activated[idx];
                }
                scratch.is_variable[idx] = true;
            }
        }

        idx = idx + 1;
    }

    mut history_count: i32 = 0;
    mut settled: bool = false;
    mut iter: i32 = 0;
    while(iter < 24) {
        idx = 0;
        while(idx < cell_count) {
            history_idx: i32 = history_count * MAP_MAX_CELLS + idx;
            scratch.history[history_idx] = scratch.is_variable[idx] && scratch.emit_curr[idx];
            idx = idx + 1;
        }
        history_count = history_count + 1;

        idx = 0;
        while(idx < cell_count) {
            scratch.emit_next[idx] = scratch.emit_curr[idx];
            if(scratch.is_variable[idx]) {
                x: i32 = idx % state.map_width;
                y = idx / state.map_width;
                mut has_input: bool = false;
                mut dy: i32 = -3;
                while(dy <= 3 && !has_input) {
                    max_abs_dx = 3 - abs_i32(dy);
                    mut dx: i32 = -max_abs_dx;
                    while(dx <= max_abs_dx) {
                        if(dx != 0 || dy != 0) {
                            tx = x + dx;
                            ty = y + dy;
                            if(map_in_bounds(state, tx, ty)) {
                                src_idx: i32 = map_index(state, tx, ty);
                                if(scratch.emit_curr[src_idx]) {
                                    has_input = true;
                                    break;
                                }
                            }
                        }
                        dx = dx + 1;
                    }
                    dy = dy + 1;
                }

                if(state.static_tiles[idx] == STATIC_TILE_FIXED_REPEATER
                    || state.dynamic_types[idx] == DYNAMIC_TILE_REPEATER) {
                    scratch.emit_next[idx] = has_input;
                } else if(state.static_tiles[idx] == STATIC_TILE_FIXED_NOT_SIGNAL
                    || state.dynamic_types[idx] == DYNAMIC_TILE_NOT_SIGNAL) {
                    scratch.emit_next[idx] = !has_input;
                }
            }
            idx = idx + 1;
        }

        mut changed: bool = false;
        idx = 0;
        while(idx < cell_count) {
            if(scratch.is_variable[idx] && scratch.emit_next[idx] != scratch.emit_curr[idx]) {
                changed = true;
                break;
            }
            idx = idx + 1;
        }
        if(!changed) {
            settled = true;
            break;
        }

        mut cycle_start: i32 = -1;
        mut t: i32 = 0;
        while(t < history_count) {
            mut equal: bool = true;
            idx = 0;
            while(idx < cell_count) {
                if(scratch.is_variable[idx]) {
                    history_idx = t * MAP_MAX_CELLS + idx;
                    if(scratch.history[history_idx] != scratch.emit_next[idx]) {
                        equal = false;
                        break;
                    }
                }
                idx = idx + 1;
            }
            if(equal) {
                cycle_start = t;
                break;
            }
            t = t + 1;
        }

        if(cycle_start >= 0) {
            idx = 0;
            while(idx < cell_count) {
                if(scratch.is_variable[idx]) {
                    first: bool = scratch.history[cycle_start * MAP_MAX_CELLS + idx];
                    mut oscillating: bool = false;
                    t = cycle_start + 1;
                    while(t < history_count) {
                        if(scratch.history[t * MAP_MAX_CELLS + idx] != first) {
                            oscillating = true;
                            break;
                        }
                        t = t + 1;
                    }
                    if(!oscillating && scratch.emit_next[idx] != first) {
                        oscillating = true;
                    }
                    if(oscillating) {
                        scratch.emit_curr[idx] = false;
                    } else {
                        scratch.emit_curr[idx] = scratch.emit_next[idx];
                    }
                }
                idx = idx + 1;
            }
            settled = true;
            break;
        }

        idx = 0;
        while(idx < cell_count) {
            scratch.emit_curr[idx] = scratch.emit_next[idx];
            idx = idx + 1;
        }

        iter = iter + 1;
    }

    if(!settled) {
        idx = 0;
        while(idx < cell_count) {
            if(scratch.is_variable[idx]) {
                scratch.emit_curr[idx] = false;
            }
            idx = idx + 1;
        }
    }

    idx = 0;
    while(idx < cell_count) {
        if(state.static_tiles[idx] == STATIC_TILE_PORTAL) {
            state.static_activated[idx] = false;
        }
        if(state.static_tiles[idx] == STATIC_TILE_FIXED_REPEATER) {
            state.static_activated[idx] = scratch.emit_curr[idx];
        } else if(state.dynamic_types[idx] == DYNAMIC_TILE_REPEATER) {
            state.dynamic_activated[idx] = scratch.emit_curr[idx];
        }

        if(state.static_tiles[idx] == STATIC_TILE_FIXED_NOT_SIGNAL) {
            state.static_activated[idx] = !scratch.emit_curr[idx];
        } else if(state.dynamic_types[idx] == DYNAMIC_TILE_NOT_SIGNAL) {
            state.dynamic_activated[idx] = !scratch.emit_curr[idx];
        }
        idx = idx + 1;
    }

    y = 0;
    while(y < state.map_height) {
        mut x: i32 = 0;
        while(x < state.map_width) {
            idx = map_index(state, x, y);
            if(state.static_tiles[idx] == STATIC_TILE_PORTAL) {
                mut on: bool = false;
                mut dy: i32 = -3;
                while(dy <= 3 && !on) {
                    max_abs_dx = 3 - abs_i32(dy);
                    mut dx: i32 = -max_abs_dx;
                    while(dx <= max_abs_dx) {
                        tx = x + dx;
                        ty = y + dy;
                        if(map_in_bounds(state, tx, ty)) {
                            src_idx = map_index(state, tx, ty);
                            if(scratch.emit_curr[src_idx]) {
                                on = true;
                                break;
                            }
                        }
                        dx = dx + 1;
                    }
                    dy = dy + 1;
                }
                state.static_activated[idx] = on;
            }
            x = x + 1;
        }
        y = y + 1;
    }

    mut has_activated: bool = false;
    mut has_deactivated: bool = false;
    idx = 0;
    while(idx < cell_count) {
        if(state.static_activated[idx] && !scratch.prev_static_activated[idx]) {
            has_activated = true;
        } else if(!state.static_activated[idx] && scratch.prev_static_activated[idx]) {
            has_deactivated = true;
        }

        if(state.dynamic_activated[idx] && !scratch.prev_dynamic_activated[idx]) {
            has_activated = true;
        } else if(!state.dynamic_activated[idx] && scratch.prev_dynamic_activated[idx]) {
            has_deactivated = true;
        }
        idx = idx + 1;
    }

    if(has_activated) {
        play_sound_if_loaded(game_resources.sfx_active);
    }
    if(has_deactivated) {
        play_sound_if_loaded(game_resources.sfx_inactive);
    }
};

pub load_level = fn(state: &mut State, level: i32) bool {
    null_file: *void = 0;
    file: *void = open_level_file(level, @as(*char, "rb"));
    if(file == null_file) {
        c.fputs(@as(*char, "load_open0\n"), c.stderr_handle());
        return false;
    }

    mut raw: MapFileBuf = @zero(MapFileBuf);
    mut line: CharBuf128 = @zero(CharBuf128);
    mut read_count: i32 = 0;
    null_line: *mut char = 0;
    while(c.fgets(&line.data[0], 128, file) != null_line) {
        mut j: i32 = 0;
        while(j < 127 && line.data[j] != '\0' && read_count < 1023) {
            raw.data[read_count] = line.data[j];
            read_count = read_count + 1;
            j = j + 1;
        }
    }
    c.fclose(file);
    raw.data[read_count] = '\0';

    mut read_msg: CharBuf32 = @zero(CharBuf32);
    c.snprintf(&read_msg.data[0], 32, @as(*char, "rct:%d\n"), read_count);
    c.fputs(&read_msg.data[0], c.stderr_handle());

    clear_map_arrays(state);
    reset_runtime_state(state);
    state.current_level = level;
    state.hero_x = 0;
    state.hero_y = 0;

    mut width: i32 = 0;
    mut height: i32 = 0;
    mut x: i32 = 0;
    mut i: i32 = 0;
    while(i < read_count) {
        ch: char = raw.data[i];
        if(ch == '\r') {
            i = i + 1;
            continue;
        }
        if(ch == '\n') {
            if(x > width) {
                width = x;
            }
            height = height + 1;
            x = 0;
        } else {
            x = x + 1;
        }
        i = i + 1;
    }
    if(x > 0) {
        if(x > width) {
            width = x;
        }
        height = height + 1;
    }

    mut size_msg: CharBuf32 = @zero(CharBuf32);
    c.snprintf(&size_msg.data[0], 32, @as(*char, "w:%d h:%d\n"), width, height);
    c.fputs(&size_msg.data[0], c.stderr_handle());

    if(width <= 0 || height <= 0 || width > MAP_MAX_WIDTH || height > MAP_MAX_HEIGHT) {
        state.map_width = 0;
        state.map_height = 0;
        return false;
    }

    state.map_width = width;
    state.map_height = height;

    x = 0;
    mut y: i32 = 0;
    i = 0;
    while(i < read_count && y < height) {
        ch = raw.data[i];
        if(ch == '\r') {
            i = i + 1;
            continue;
        }
        if(ch == '\n') {
            y = y + 1;
            x = 0;
            i = i + 1;
            continue;
        }
        if(x < width) {
            idx: i32 = map_index(state, x, y);
            if(ch == '#') {
                state.static_tiles[idx] = STATIC_TILE_WALL;
            } else if(ch == '@') {
                state.hero_x = x;
                state.hero_y = y;
            } else if(ch == 'o') {
                state.dynamic_types[idx] = DYNAMIC_TILE_BOX;
            } else if(ch == 's') {
                state.dynamic_types[idx] = DYNAMIC_TILE_SIGNAL_SOURCE;
            } else if(ch == 'r') {
                state.dynamic_types[idx] = DYNAMIC_TILE_REPEATER;
            } else if(ch == 'n') {
                state.dynamic_types[idx] = DYNAMIC_TILE_NOT_SIGNAL;
            } else if(ch == 'P') {
                state.static_tiles[idx] = STATIC_TILE_PORTAL;
            } else if(ch == 'S') {
                state.static_tiles[idx] = STATIC_TILE_FIXED_SIGNAL_SOURCE;
            } else if(ch == 'R') {
                state.static_tiles[idx] = STATIC_TILE_FIXED_REPEATER;
            } else if(ch == 'N') {
                state.static_tiles[idx] = STATIC_TILE_FIXED_NOT_SIGNAL;
            }
        }
        x = x + 1;
        i = i + 1;
    }

    recalculate_activation(state);
    return true;
};

pub push_undo = fn(state: &mut State) void {
    if(state.undo_count >= UNDO_MAX) {
        mut i: i32 = 1;
        while(i < UNDO_MAX) {
            state.undo_states[i - 1] = state.undo_states[i];
            i = i + 1;
        }
        state.undo_count = UNDO_MAX - 1;
    }

    mut snapshot: UndoState = @zero(UndoState);
    snapshot.hero_x = state.hero_x;
    snapshot.hero_y = state.hero_y;
    mut i: i32 = 0;
    while(i < MAP_MAX_CELLS) {
        snapshot.dynamic_types[i] = state.dynamic_types[i];
        snapshot.static_activated[i] = state.static_activated[i];
        snapshot.dynamic_activated[i] = state.dynamic_activated[i];
        i = i + 1;
    }

    state.undo_states[state.undo_count] = snapshot;
    state.undo_count = state.undo_count + 1;
};

pub pop_undo = fn(state: &mut State) bool {
    if(state.undo_count <= 0) {
        return false;
    }

    state.undo_count = state.undo_count - 1;
    snapshot: UndoState = state.undo_states[state.undo_count];
    state.hero_x = snapshot.hero_x;
    state.hero_y = snapshot.hero_y;

    mut i: i32 = 0;
    while(i < MAP_MAX_CELLS) {
        state.dynamic_types[i] = snapshot.dynamic_types[i];
        state.static_activated[i] = snapshot.static_activated[i];
        state.dynamic_activated[i] = snapshot.dynamic_activated[i];
        i = i + 1;
    }

    return true;
};

pub next_level = fn(state: &mut State) bool {
    mut next: i32 = state.current_level + 1;
    if(!level_exists(next)) {
        next = 1;
    }
    return load_level(state, next);
};

pub try_move = fn(state: &mut State, dx: i32, dy: i32) bool {
    new_x: i32 = state.hero_x + dx;
    new_y: i32 = state.hero_y + dy;
    if(!map_in_bounds(state, new_x, new_y)) {
        return false;
    }

    target_idx: i32 = map_index(state, new_x, new_y);
    push_undo(state);

    mut moved: bool = false;
    if(state.dynamic_types[target_idx] != DYNAMIC_TILE_NONE) {
        if(try_push_chain(state, new_x, new_y, dx, dy)) {
            state.hero_x = new_x;
            state.hero_y = new_y;
            moved = true;
        }
    } else if(static_is_walkable_for_hero(state.static_tiles[target_idx], state.static_activated[target_idx])) {
        state.hero_x = new_x;
        state.hero_y = new_y;
        moved = true;
    }

    if(!moved) {
        state.undo_count = state.undo_count - 1;
        return false;
    }

    play_sound_if_loaded(game_resources.sfx_move);
    recalculate_activation(state);
    if(state.static_tiles[target_idx] == STATIC_TILE_PORTAL && state.static_activated[target_idx]) {
        play_sound_if_loaded(game_resources.sfx_transport);
        next_level(state);
    }
    return true;
};

pub command_is_solve = fn(state: &State) bool {
    solve_text: Array(char, 7) = ['/', 's', 'o', 'l', 'v', 'e', '\0'];
    if(state.command_len != 6) {
        return false;
    }
    mut i: i32 = 0;
    while(i < 6) {
        if(state.command_buffer[i] != solve_text[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
};

pub parse_level_command = fn(state: &State) i32 {
    if(state.command_len < 2 || state.command_buffer[0] != '/') {
        return -1;
    }

    mut value: i32 = 0;
    mut i: i32 = 1;
    while(i < state.command_len) {
        ch: char = state.command_buffer[i];
        if(ch < '0' || ch > '9') {
            return -1;
        }
        value = value * 10 + (ch - '0');
        i = i + 1;
    }
    return value;
};

pub submit_command = fn(state: &mut State) void {
    if(command_is_solve(state)) {
        set_hint(state, @as(*char, "solver unavailable"), 18, 2.0);
        clear_command(state);
        return;
    }

    level: i32 = parse_level_command(state);
    if(level > 0) {
        if(load_level(state, level)) {
            clear_command(state);
            return;
        }
        set_hint(state, @as(*char, "level not found"), 15, 2.0);
        clear_command(state);
        return;
    }

    set_hint(state, @as(*char, "syntax error"), 12, 2.0);
    clear_command(state);
};

pub append_command_char = fn(state: &mut State, ch: char) void {
    if(state.command_visible && state.command_len < COMMAND_BUFFER_CAP - 1) {
        state.command_buffer[state.command_len] = ch;
        state.command_len = state.command_len + 1;
        state.command_buffer[state.command_len] = '\0';
    }
};

pub handle_command_input = fn(state: &mut State) void {
    mut opened_this_frame: bool = false;
    if(!state.command_visible && rl.IsKeyPressed(rl.KEY_SLASH)) {
        state.command_visible = true;
        state.command_len = 1;
        state.command_buffer[0] = '/';
        state.command_buffer[1] = '\0';
        opened_this_frame = true;
    }

    if(!state.command_visible) {
        return;
    }

    if(!opened_this_frame) {
        if(rl.IsKeyPressed(KEY_0)) { append_command_char(state, '0'); }
        if(rl.IsKeyPressed(KEY_1)) { append_command_char(state, '1'); }
        if(rl.IsKeyPressed(KEY_2)) { append_command_char(state, '2'); }
        if(rl.IsKeyPressed(KEY_3)) { append_command_char(state, '3'); }
        if(rl.IsKeyPressed(KEY_4)) { append_command_char(state, '4'); }
        if(rl.IsKeyPressed(KEY_5)) { append_command_char(state, '5'); }
        if(rl.IsKeyPressed(KEY_6)) { append_command_char(state, '6'); }
        if(rl.IsKeyPressed(KEY_7)) { append_command_char(state, '7'); }
        if(rl.IsKeyPressed(KEY_8)) { append_command_char(state, '8'); }
        if(rl.IsKeyPressed(KEY_9)) { append_command_char(state, '9'); }
        if(rl.IsKeyPressed(KEY_E)) { append_command_char(state, 'e'); }
        if(rl.IsKeyPressed(KEY_L)) { append_command_char(state, 'l'); }
        if(rl.IsKeyPressed(KEY_O)) { append_command_char(state, 'o'); }
        if(rl.IsKeyPressed(KEY_S_LOWER)) { append_command_char(state, 's'); }
        if(rl.IsKeyPressed(KEY_V)) { append_command_char(state, 'v'); }
    }

    if(rl.IsKeyPressed(rl.KEY_BACKSPACE) && state.command_len > 0) {
        state.command_len = state.command_len - 1;
        state.command_buffer[state.command_len] = '\0';
        if(state.command_len == 0) {
            state.command_visible = false;
        }
    }

    if(rl.IsKeyPressed(rl.KEY_ESCAPE)) {
        clear_command(state);
    } else if(rl.IsKeyPressed(rl.KEY_ENTER) || rl.IsKeyPressed(rl.KEY_KP_ENTER)) {
        submit_command(state);
    }
};

pub draw_texture_cell = fn(texture: rl.Texture2D, px: i32, py: i32, cell_size: i32) void {
    src: rl.Rectangle = rl.Rectangle {
        .x = 0.0,
        .y = 0.0,
        .width = @as(f32, texture.width),
        .height = @as(f32, texture.height),
    };
    dst: rl.Rectangle = rl.Rectangle {
        .x = @as(f32, px),
        .y = @as(f32, py),
        .width = @as(f32, cell_size),
        .height = @as(f32, cell_size),
    };
    origin: rl.Vector2 = rl.Vector2 {.x = 0.0, .y = 0.0};
    rl.DrawTexturePro(texture, src, dst, origin, 0.0, rl.WHITE);
};

pub draw_ambient_background = fn() void {
    mut i: i32 = 0;
    square_radius: f32 = @as(f32, 3.0);
    square_size: f32 = square_radius * @as(f32, 2.0);
    while(i < AMBIENT_FLOATING_SQUARE_COUNT) {
        sq: FloatingSquare = game_resources.ambient_squares[i];
        px: f32 = sq.anchor.x + c.sinf(game_resources.ambient_time * sq.speed_x + sq.phase_x) * sq.amp_x;
        py: f32 = sq.anchor.y + c.cosf(game_resources.ambient_time * sq.speed_y + sq.phase_y) * sq.amp_y;
        rl.DrawRectangleV(
            rl.Vector2 {.x = px - square_radius, .y = py - square_radius},
            rl.Vector2 {.x = square_size, .y = square_size},
            COLOR_AMBIENT
        );
        i = i + 1;
    }
};

pub draw_static_tile = fn(tile: i32, activated: bool, px: i32, py: i32, cell_size: i32) void {
    rl.DrawRectangle(px, py, cell_size, cell_size, COLOR_FLOOR);

    if(tile == STATIC_TILE_WALL) {
        draw_texture_cell(game_resources.wall_texture, px, py, cell_size);
        return;
    }

    if(tile == STATIC_TILE_PORTAL) {
        if(activated) {
            draw_texture_cell(game_resources.portal_active_texture, px, py, cell_size);
        } else {
            draw_texture_cell(game_resources.portal_inactive_texture, px, py, cell_size);
        }
        return;
    }

    if(tile == STATIC_TILE_FIXED_SIGNAL_SOURCE) {
        draw_texture_cell(game_resources.fixed_signal_source_texture, px, py, cell_size);
        return;
    }

    if(tile == STATIC_TILE_FIXED_REPEATER) {
        if(activated) {
            draw_texture_cell(game_resources.fixed_repeater_active_texture, px, py, cell_size);
        } else {
            draw_texture_cell(game_resources.fixed_repeater_inactive_texture, px, py, cell_size);
        }
        return;
    }

    if(tile == STATIC_TILE_FIXED_NOT_SIGNAL) {
        if(activated) {
            draw_texture_cell(game_resources.fixed_not_signal_active_texture, px, py, cell_size);
        } else {
            draw_texture_cell(game_resources.fixed_not_signal_inactive_texture, px, py, cell_size);
        }
    }
};

pub draw_dynamic_tile = fn(tile: i32, activated: bool, px: i32, py: i32, cell_size: i32) void {
    if(tile == DYNAMIC_TILE_NONE) {
        return;
    }

    if(tile == DYNAMIC_TILE_BOX) {
        draw_texture_cell(game_resources.box_texture, px, py, cell_size);
        return;
    }

    if(tile == DYNAMIC_TILE_SIGNAL_SOURCE) {
        draw_texture_cell(game_resources.signal_source_texture, px, py, cell_size);
        return;
    }

    if(tile == DYNAMIC_TILE_REPEATER) {
        if(activated) {
            draw_texture_cell(game_resources.repeater_active_texture, px, py, cell_size);
        } else {
            draw_texture_cell(game_resources.repeater_inactive_texture, px, py, cell_size);
        }
        return;
    }

    if(tile == DYNAMIC_TILE_NOT_SIGNAL) {
        if(activated) {
            draw_texture_cell(game_resources.not_signal_active_texture, px, py, cell_size);
        } else {
            draw_texture_cell(game_resources.not_signal_inactive_texture, px, py, cell_size);
        }
        return;
    }
};

pub is_particle_emitter_at = fn(state: &State, idx: i32) bool {
    if(state.static_tiles[idx] == STATIC_TILE_FIXED_SIGNAL_SOURCE) {
        return true;
    }
    if(state.dynamic_types[idx] == DYNAMIC_TILE_SIGNAL_SOURCE) {
        return true;
    }
    if(state.static_tiles[idx] == STATIC_TILE_FIXED_REPEATER && state.static_activated[idx]) {
        return true;
    }
    if(state.dynamic_types[idx] == DYNAMIC_TILE_REPEATER && state.dynamic_activated[idx]) {
        return true;
    }
    if(state.static_tiles[idx] == STATIC_TILE_FIXED_NOT_SIGNAL && !state.static_activated[idx]) {
        return true;
    }
    if(state.dynamic_types[idx] == DYNAMIC_TILE_NOT_SIGNAL && !state.dynamic_activated[idx]) {
        return true;
    }
    return false;
};

pub compute_viewport = fn(state: &State) Viewport {
    padding_x: i32 = 120;
    padding_y: i32 = 100;
    available_w: i32 = WINDOW_WIDTH - padding_x * 2;
    available_h: i32 = WINDOW_HEIGHT - padding_y * 2;
    cell_w: i32 = available_w / state.map_width;
    cell_h: i32 = available_h / state.map_height;
    mut cell_size: i32 = min_i32(cell_w, cell_h);
    if(cell_size < 16) {
        cell_size = 16;
    }

    map_px_w: i32 = state.map_width * cell_size;
    map_px_h: i32 = state.map_height * cell_size;
    return Viewport {
        .origin_x = (WINDOW_WIDTH - map_px_w) / 2,
        .origin_y = (WINDOW_HEIGHT - map_px_h) / 2,
        .cell_size = cell_size,
    };
};

pub spawn_emitter_particles = fn(state: &mut State, emitter_x: i32, emitter_y: i32, view: &Viewport) void {
    cell_size: f32 = @as(f32, view.cell_size);
    center_x: f32 = @as(f32, view.origin_x) + @as(f32, emitter_x) * cell_size;
    center_y: f32 = @as(f32, view.origin_y) + @as(f32, emitter_y) * cell_size;
    particle_radius: f32 = cell_size * @as(f32, 0.07);
    jitter: f32 = cell_size * @as(f32, 0.2);
    speed: f32 = cell_size * @as(f32, 0.35);
    color: rl.Color = rl.Color {.r = 95, .g = 205, .b = 228, .a = 210};

    mut i: i32 = 0;
    while(i < PARTICLES_PER_EMITTER_BURST && state.particle_count < PARTICLE_MAX) {
        pick: i32 = rl.GetRandomValue(0, 11);
        dx: i32 = boundary_offset_x(pick);
        dy: i32 = boundary_offset_y(pick);
        px: f32 = center_x
            + @as(f32, dx) * cell_size
            + (random_0_1() - @as(f32, 0.5)) * @as(f32, 2.0) * jitter;
        py: f32 = center_y
            + @as(f32, dy) * cell_size
            + (random_0_1() - @as(f32, 0.5)) * @as(f32, 2.0) * jitter;
        mut vx: f32 = center_x - px;
        mut vy: f32 = center_y - py;
        len: f32 = c.sqrtf(vx * vx + vy * vy);
        if(len >= @as(f32, 0.0001)) {
            vx = (vx / len) * speed;
            vy = (vy / len) * speed;
            state.particles[state.particle_count] = Particle {
                .position = rl.Vector2 {.x = px, .y = py},
                .velocity = rl.Vector2 {.x = vx, .y = vy},
                .radius = particle_radius,
                .life = @as(f32, 0.9) + random_0_1() * @as(f32, 0.6),
                .color = color,
            };
            state.particle_count = state.particle_count + 1;
        }
        i = i + 1;
    }
};

pub update_map_particles = fn(state: &mut State) void {
    if(state.map_width <= 0 || state.map_height <= 0) {
        state.particle_count = 0;
        state.particle_spawn_timer = 0.0;
        return;
    }

    dt: f32 = rl.GetFrameTime();
    state.particle_spawn_timer = state.particle_spawn_timer + dt;
    if(state.particle_spawn_timer >= PARTICLE_SPAWN_INTERVAL) {
        state.particle_spawn_timer = state.particle_spawn_timer - PARTICLE_SPAWN_INTERVAL;
        mut view: Viewport = compute_viewport(state);
        mut y: i32 = 0;
        while(y < state.map_height) {
            mut x: i32 = 0;
            while(x < state.map_width) {
                idx: i32 = map_index(state, x, y);
                if(is_particle_emitter_at(state, idx)) {
                    spawn_emitter_particles(state, x, y, view);
                }
                x = x + 1;
            }
            y = y + 1;
        }
    }

    mut i: i32 = 0;
    while(i < state.particle_count) {
        state.particles[i].life = state.particles[i].life - dt;
        if(state.particles[i].life > 0.0) {
            state.particles[i].position.x = state.particles[i].position.x + state.particles[i].velocity.x * dt;
            state.particles[i].position.y = state.particles[i].position.y + state.particles[i].velocity.y * dt;
            i = i + 1;
        } else {
            state.particle_count = state.particle_count - 1;
            state.particles[i] = state.particles[state.particle_count];
        }
    }
};

pub update_game = fn(state: &mut State) void {
    dt: f32 = rl.GetFrameTime();
    handle_command_input(state);
    if(!state.command_visible) {
        if(rl.IsKeyPressed(rl.KEY_R)) {
            load_level(state, state.current_level);
        } else if(rl.IsKeyPressed(rl.KEY_Z)) {
            pop_undo(state);
        } else if(rl.IsKeyPressed(rl.KEY_W)) {
            try_move(state, 0, -1);
        } else if(rl.IsKeyPressed(rl.KEY_S)) {
            try_move(state, 0, 1);
        } else if(rl.IsKeyPressed(rl.KEY_A)) {
            try_move(state, -1, 0);
        } else if(rl.IsKeyPressed(rl.KEY_D)) {
            try_move(state, 1, 0);
        }
    }

    game_resources.ambient_time = game_resources.ambient_time + dt;
    update_map_particles(state);
    if(game_resources.bgm_loaded) {
        rl.UpdateMusicStream(game_resources.bgm);
        if(!rl.IsMusicStreamPlaying(game_resources.bgm)) {
            rl.PlayMusicStream(game_resources.bgm);
        }
    }

    if(state.hint_timer > 0.0) {
        state.hint_timer = state.hint_timer - dt;
        if(state.hint_timer < 0.0) {
            state.hint_timer = 0.0;
        }
    }
};

pub draw_map_cells = fn(state: &State, view: &Viewport) void {
    mut y: i32 = 0;
    while(y < state.map_height) {
        mut x: i32 = 0;
        while(x < state.map_width) {
            idx: i32 = map_index(state, x, y);
            px: i32 = view.origin_x + x * view.cell_size;
            py: i32 = view.origin_y + y * view.cell_size;
            static_tile: i32 = state.static_tiles[idx];
            static_active: bool = state.static_activated[idx];
            cell_size: i32 = view.cell_size;
            draw_static_tile(static_tile, static_active, px, py, cell_size);
            draw_dynamic_tile(state.dynamic_types[idx], state.dynamic_activated[idx], px, py, cell_size);

            if(state.hero_x == x && state.hero_y == y) {
                draw_texture_cell(game_resources.hero_texture, px, py, view.cell_size);
            }
            x = x + 1;
        }
        y = y + 1;
    }
};

pub draw_particles = fn(state: &State) void {
    mut i: i32 = 0;
    while(i < state.particle_count) {
        rl.DrawCircleV(state.particles[i].position, state.particles[i].radius, state.particles[i].color);
        i = i + 1;
    }
};

pub draw_overlay = fn(state: &State) void {
    mut level_text: CharBuf32 = @zero(CharBuf32);
    c.snprintf(&level_text.data[0], 32, @as(*char, "Level %d"), state.current_level);
    rl.DrawText(&level_text.data[0], 24, 24, 28, rl.RAYWHITE);

    rl.DrawText(@as(*char, "WASD Z R /<n>"), 24, WINDOW_HEIGHT - 48, 20, rl.LIGHTGRAY);

    if(state.hint_timer > 0.0 && state.hint_len > 0) {
        rl.DrawRectangle(20, 62, 260, 32, rl.Fade(rl.BLACK, @as(f32, 0.55)));
        rl.DrawText(&state.hint_buffer[0], 28, 68, 20, rl.RAYWHITE);
    }

    if(state.command_visible) {
        rl.DrawRectangle(20, 104, 320, 40, rl.Fade(rl.BLACK, @as(f32, 0.7)));
        rl.DrawText(&state.command_buffer[0], 28, 114, 22, rl.RAYWHITE);
    }
};

pub draw_scene = fn(state: &State) void {
    rl.ClearBackground(COLOR_BG);
    draw_ambient_background();
    if(state.map_width <= 0) {
        if(state.hint_len > 0) {
            rl.DrawText(&state.hint_buffer[0], 24, 24, 24, rl.RAYWHITE);
        }
        return;
    }

    if(state.map_height <= 0) {
        if(state.hint_len > 0) {
            rl.DrawText(&state.hint_buffer[0], 24, 24, 24, rl.RAYWHITE);
        }
        return;
    }

    mut view: Viewport = compute_viewport(state);
    draw_map_cells(state, view);
    draw_particles(state);
    draw_overlay(state);
};

pub init_window = fn() void {
    rl.InitWindow(WINDOW_WIDTH, WINDOW_HEIGHT, @as(*char, "Notgate"));
    rl.SetTargetFPS(60);
    init_game_resources();
};

pub initial_load = fn(state: &mut State) void {
    c.fputs(@as(*char, "notgate: initial_load begin"), c.stderr_handle());
    if(!load_level(state, 1)) {
        set_hint(state, @as(*char, "load failed"), 11, 60.0);
    }
    mut init_msg: CharBuf32 = @zero(CharBuf32);
    c.snprintf(&init_msg.data[0], 32, @as(*char, "il:%d,%d\n"), state.map_width, state.map_height);
    c.fputs(&init_msg.data[0], c.stderr_handle());
    c.fputs(@as(*char, "notgate: initial_load end"), c.stderr_handle());
};

pub run_frame = fn(state: &mut State) void {
    update_game(state);

    rl.BeginTextureMode(game_resources.scene_target);
    draw_scene(state);
    rl.EndTextureMode();

    rl.BeginDrawing();
    rl.ClearBackground(rl.BLACK);
    source: rl.Rectangle = rl.Rectangle {
        .x = 0.0,
        .y = 0.0,
        .width = @as(f32, game_resources.scene_target.texture.width),
        .height = -@as(f32, game_resources.scene_target.texture.height),
    };
    origin: rl.Vector2 = rl.Vector2 {.x = 0.0, .y = 0.0};
    if(game_resources.use_postprocess) {
        rl.BeginShaderMode(game_resources.postprocess_shader);
        rl.DrawTextureRec(game_resources.scene_target.texture, source, origin, rl.WHITE);
        rl.EndShaderMode();
    } else {
        rl.DrawTextureRec(game_resources.scene_target.texture, source, origin, rl.WHITE);
    }
    rl.EndDrawing();
};

pub run = fn() void {
    init_empty_state(runtime_state);
    init_window();
    initial_load(runtime_state);
    while(!rl.WindowShouldClose()) {
        run_frame(runtime_state);
    }

    shutdown_game_resources();
    rl.CloseWindow();
};
