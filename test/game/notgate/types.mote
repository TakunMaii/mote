@package("notgate");


pub Vec2i = struct {
    x: i32,
    y: i32,
};

pub FloatingSquare = struct {
    anchor: rl.Vector2,
    amp_x: f32,
    amp_y: f32,
    speed_x: f32,
    speed_y: f32,
    phase_x: f32,
    phase_y: f32,
};

pub Particle = struct {
    position: rl.Vector2,
    velocity: rl.Vector2,
    radius: f32,
    life: f32,
    color: rl.Color,
};

pub Viewport = struct {
    origin_x: i32,
    origin_y: i32,
    cell_size: i32,
};

pub UndoState = struct {
    hero_x: i32,
    hero_y: i32,
    dynamic_types: Array(i32, 345),
    static_activated: Array(bool, 345),
    dynamic_activated: Array(bool, 345),
};

pub CharBuf32 = struct {
    data: Array(char, 32),
};

pub CharBuf64 = struct {
    data: Array(char, 64),
};

pub CharBuf128 = struct {
    data: Array(char, 128),
};

pub MapFileBuf = struct {
    data: Array(char, 1024),
};

pub ActivationScratch = struct {
    prev_static_activated: Array(bool, 345),
    prev_dynamic_activated: Array(bool, 345),
    const_emitter: Array(bool, 345),
    const_hits_not: Array(bool, 345),
    force_not_off: Array(bool, 345),
    emit_curr: Array(bool, 345),
    emit_next: Array(bool, 345),
    is_variable: Array(bool, 345),
    component_id: Array(i32, 345),
    queue: Array(i32, 345),
    history: Array(bool, 8280),
    component_size: Array(i32, 345),
    component_hit_count: Array(i32, 345),
};

pub GameResources = struct {
    wall_texture: rl.Texture2D,
    box_texture: rl.Texture2D,
    hero_texture: rl.Texture2D,
    signal_source_texture: rl.Texture2D,
    fixed_signal_source_texture: rl.Texture2D,
    portal_inactive_texture: rl.Texture2D,
    portal_active_texture: rl.Texture2D,
    repeater_inactive_texture: rl.Texture2D,
    repeater_active_texture: rl.Texture2D,
    fixed_repeater_inactive_texture: rl.Texture2D,
    fixed_repeater_active_texture: rl.Texture2D,
    not_signal_inactive_texture: rl.Texture2D,
    not_signal_active_texture: rl.Texture2D,
    fixed_not_signal_inactive_texture: rl.Texture2D,
    fixed_not_signal_active_texture: rl.Texture2D,

    sfx_active: rl.Sound,
    sfx_inactive: rl.Sound,
    sfx_move: rl.Sound,
    sfx_transport: rl.Sound,
    sounds_loaded: bool,

    bgm: rl.Music,
    bgm_loaded: bool,

    scene_target: rl.RenderTexture2D,
    render_target_loaded: bool,

    postprocess_shader: rl.Shader,
    use_postprocess: bool,
    post_vignette_loc: i32,
    post_bloom_threshold_loc: i32,
    post_bloom_strength_loc: i32,

    ambient_squares: Array(FloatingSquare, 16),
    ambient_ready: bool,
    ambient_time: f32,
};

pub State = struct {
    map_width: i32,
    map_height: i32,
    current_level: i32,

    hero_x: i32,
    hero_y: i32,

    static_tiles: Array(i32, 345),
    dynamic_types: Array(i32, 345),
    static_activated: Array(bool, 345),
    dynamic_activated: Array(bool, 345),

    undo_count: i32,
    undo_states: Array(UndoState, 256),

    command_visible: bool,
    command_len: i32,
    command_buffer: Array(char, 32),

    hint_len: i32,
    hint_buffer: Array(char, 64),
    hint_timer: f32,

    particle_spawn_timer: f32,
    particle_count: i32,
    particles: Array(Particle, 100),
};
