glfw :: @import("vendor:glfw");
gl :: @import("vendor:opengl");

clear_mask: u32 = gl.COLOR_BUFFER_BIT;
draw_mode: u32 = gl.TRIANGLES;
buffer_target: u32 = gl.ARRAY_BUFFER;
shader_kind: u32 = gl.VERTEX_SHADER;
texture_unit: u32 = gl.TEXTURE0;

main :: fn() i32 {
    if(clear_mask == 0 || draw_mode == 0 || buffer_target == 0 ||
       shader_kind == 0 || texture_unit == 0) {
        return 1;
    }

    ok: i32 = glfw.Init();
    if(ok == glfw.FALSE) {
        return 2;
    }

    glfw.WindowHint(glfw.CONTEXT_VERSION_MAJOR, 3);
    glfw.WindowHint(glfw.CONTEXT_VERSION_MINOR, 3);
    glfw.WindowHint(glfw.OPENGL_PROFILE, glfw.OPENGL_CORE_PROFILE);

    window := glfw.CreateWindow(160, 120, "opengl smoke", 0, 0);
    if(window == 0) {
        glfw.Terminate();
        return 3;
    }

    glfw.MakeContextCurrent(window);
    gl.LoadWith(glfw.GetProcAddress);

    if(gl.Clear == 0 || gl.ClearColor == 0 || gl.CreateShader == 0 || gl.DrawArrays == 0) {
        glfw.DestroyWindow(window);
        glfw.Terminate();
        return 4;
    }

    glfw.DestroyWindow(window);
    glfw.Terminate();
    return 0;
};