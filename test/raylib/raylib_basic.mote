rl = @import("raylib");

mut color_index: i32 = 0;
mut pulse: f64 = 0.0;

rl.InitWindow(960, 540, @as(*char, "mote + raylib"));
rl.SetTargetFPS(60);

while(!rl.WindowShouldClose()) {
    if(rl.IsKeyPressed(rl.KEY_SPACE)) {
        color_index = color_index + 1;
        if(color_index >= 4) {
            color_index = 0;
        }
    }

    pulse = pulse + rl.GetFrameTime() * 120.0;
    if(pulse > 360.0) {
        pulse = pulse - 360.0;
    }

    mut draw_color: rl.Color = rl.BLUE;
    if(color_index == 1) {
        draw_color = rl.GREEN;
    } else if(color_index == 2) {
        draw_color = rl.YELLOW;
    } else if(color_index == 3) {
        draw_color = rl.RED;
    }

    rl.BeginDrawing();
    rl.ClearBackground(rl.RAYWHITE);
    rl.DrawRectangle(120, 100, 720, 320, rl.LIGHTGRAY);
    rl.DrawCircleV(rl.Vector2 {.x = 480.0, .y = 260.0}, 72.0, draw_color);
    rl.DrawText(@as(*char, "SPACE changes color, ESC quits"), 180, 420, 20, rl.DARKGRAY);
    rl.EndDrawing();
}

rl.CloseWindow();
