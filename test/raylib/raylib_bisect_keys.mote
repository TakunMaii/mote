rl :: @import("vendor:raylib");

color_index: i32 = 0;
frames: i32 = 0;

rl.InitWindow(320, 240, "bisect keys");
rl.SetTargetFPS(60);

while(!rl.WindowShouldClose() && frames < 2) {
    if(rl.IsKeyPressed(rl.KEY_SPACE)) {
        color_index = color_index + 1;
        if(color_index >= 4) {
            color_index = 0;
        }
    }

    frames = frames + 1;
}

rl.CloseWindow();