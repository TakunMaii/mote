rl :: @import("vendor:raylib");

color_index: i32 = 0;
frames: i32 = 0;

rl.InitWindow(320, 240, "bisect else if");
rl.SetTargetFPS(60);

while(!rl.WindowShouldClose() && frames < 2) {
    draw_color: rl.Color = rl.BLUE;
    if(color_index == 1) {
        draw_color = rl.GREEN;
    } else if(color_index == 2) {
        draw_color = rl.YELLOW;
    } else if(color_index == 3) {
        draw_color = rl.RED;
    }

    rl.BeginDrawing();
    rl.ClearBackground(rl.RAYWHITE);
    rl.DrawCircleV(rl.Vector2 {.x = 160.0, .y = 120.0}, 40.0, draw_color);
    rl.EndDrawing();
    frames = frames + 1;
}

rl.CloseWindow();