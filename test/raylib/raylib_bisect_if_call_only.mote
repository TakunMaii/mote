rl = @import("raylib");

mut frames: i32 = 0;

rl.InitWindow(320, 240, @as(*char, "bisect if call"));
rl.SetTargetFPS(60);

while(!rl.WindowShouldClose() && frames < 2) {
    if(rl.IsKeyPressed(32)) {
        frames = frames + 1;
    }

    rl.BeginDrawing();
    rl.ClearBackground(rl.RAYWHITE);
    rl.EndDrawing();
    frames = frames + 1;
}

rl.CloseWindow();
