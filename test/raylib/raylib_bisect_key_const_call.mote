rl = @import("vendor/raylib");

mut frames: i32 = 0;

rl.InitWindow(320, 240, "bisect key const call");
rl.SetTargetFPS(60);

while(!rl.WindowShouldClose() && frames < 2) {
    if(rl.IsKeyPressed(rl.KEY_SPACE)) {
        frames = frames + 1;
    }

    rl.BeginDrawing();
    rl.ClearBackground(rl.RAYWHITE);
    rl.EndDrawing();
    frames = frames + 1;
}

rl.CloseWindow();
