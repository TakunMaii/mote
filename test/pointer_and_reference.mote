
mut x: i32 = 2;
x_ptr: *i32 = &x;// 指针类型和取址
x_mut_ptr: *mut i32 = &mut x;// 可变指针，*mut，代表指针的内容可变
// 但是同时x_mut_ptr本身又是不可变变量，这就是说让x_mut_ptr指向新的地址是不可行的，
// 只是说改变其指向的位置的值是可行的

x_value = *x_ptr;//取值，不管可不可变都能取值
x_ref: &i32 = x;//引用类型
mut x_mut_ref: &mut i32 = x;//可变引用，&mut，代表引用的内容可变，只有可变的变量才能有可变的引用（可以同时有多个可变引用，其中一个变化其他一起变化）
// 可变引用本身也要是可变的才能变（不可变的可变引用本身是符合语法的，虽然还是不可变，没太大意义）
*x_mut_ptr = 5;
x_mut_ref = 6;
