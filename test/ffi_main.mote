c_mem = @import("c/memory");
c_file = @import("c/file");
c_io = @import("c/io");

heap: *mut char = c_mem.malloc(1);
*heap = 'A';
c_io.putchar(*heap);
c_mem.free(heap);

data: Array(char, 5) = ['h', 'e', 'l', 'l', 'o'];
mut copy: Array(char, 5) = ['\0', '\0', '\0', '\0', '\0'];
c_mem.memcpy(&copy[0], &data[0], 5);
c_mem.memset(&copy[0], 'x', 1);

path: Array(char, 12) = ['f', 'f', 'i', '_', 'o', 'u', 't', '.', 't', 'x', 't', '\0'];
write_mode: Array(char, 3) = ['w', 'b', '\0'];
read_mode: Array(char, 3) = ['r', 'b', '\0'];

writer: *void = c_file.fopen(&path[0], &write_mode[0]);
written: i64 = c_file.fwrite(&copy[0], 1, 5, writer);
c_file.fclose(writer);

mut read_back: Array(char, 5) = ['\0', '\0', '\0', '\0', '\0'];
reader: *void = c_file.fopen(&path[0], &read_mode[0]);
read_count: i64 = c_file.fread(&read_back[0], 1, 5, reader);
c_file.fclose(reader);

if(written == 5 && read_count == 5 && read_back[0] == 'x' && read_back[1] == 'e') {
    c_io.putchar('O');
    c_io.putchar('K');
}

c_io.putchar('\n');
c_file.remove(&path[0]);
