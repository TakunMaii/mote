@package("image");

pub RGB :: 3;
pub RGBA :: 4;

pub Load :: @extern("stbi_load", Function([*char, *i32, *i32, *i32, i32], *u8));
pub LoadFromMemory :: @extern("stbi_load_from_memory", Function([*u8, i32, *i32, *i32, *i32, i32], *u8));
pub Info :: @extern("stbi_info", Function([*char, *i32, *i32, *i32], i32));
pub ImageFree :: @extern("stbi_image_free", Function([*void], void));
pub FailureReason :: @extern("stbi_failure_reason", Function([], *char));
pub SetFlipVerticallyOnLoad :: @extern("stbi_set_flip_vertically_on_load", Function([i32], void));