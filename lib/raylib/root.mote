pub Vector2 = struct {
    x: f32,
    y: f32,
};

pub Color = struct {
    r: u8,
    g: u8,
    b: u8,
    a: u8,
};

pub KEY_SPACE = 32;
pub KEY_ESCAPE = 256;

pub LIGHTGRAY: Color = Color {.r = 200, .g = 200, .b = 200, .a = 255};
pub GRAY: Color = Color {.r = 130, .g = 130, .b = 130, .a = 255};
pub DARKGRAY: Color = Color {.r = 80, .g = 80, .b = 80, .a = 255};
pub YELLOW: Color = Color {.r = 253, .g = 249, .b = 0, .a = 255};
pub GREEN: Color = Color {.r = 0, .g = 228, .b = 48, .a = 255};
pub BLUE: Color = Color {.r = 0, .g = 121, .b = 241, .a = 255};
pub RED: Color = Color {.r = 230, .g = 41, .b = 55, .a = 255};
pub WHITE: Color = Color {.r = 255, .g = 255, .b = 255, .a = 255};
pub BLACK: Color = Color {.r = 0, .g = 0, .b = 0, .a = 255};
pub RAYWHITE: Color = Color {.r = 245, .g = 245, .b = 245, .a = 255};

pub InitWindow = @extern("InitWindow", Function([i32, i32, *char], void));
pub CloseWindow = @extern("CloseWindow", Function([], void));
pub WindowShouldClose = @extern("WindowShouldClose", Function([], bool));
pub SetTargetFPS = @extern("SetTargetFPS", Function([i32], void));
pub BeginDrawing = @extern("BeginDrawing", Function([], void));
pub EndDrawing = @extern("EndDrawing", Function([], void));
pub ClearBackground = @extern("ClearBackground", Function([Color], void));
pub DrawText = @extern("DrawText", Function([*char, i32, i32, i32, Color], void));
pub DrawRectangle = @extern("DrawRectangle", Function([i32, i32, i32, i32, Color], void));
pub DrawCircleV = @extern("DrawCircleV", Function([Vector2, f32, Color], void));
pub IsKeyPressed = @extern("IsKeyPressed", Function([i32], bool));
pub IsKeyDown = @extern("IsKeyDown", Function([i32], bool));
pub GetFrameTime = @extern("GetFrameTime", Function([], f32));
pub GetTime = @extern("GetTime", Function([], f64));
pub GetRandomValue = @extern("GetRandomValue", Function([i32, i32], i32));
