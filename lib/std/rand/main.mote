@package("rand");

pub RNG = struct {
    state: u64,
};

pub init = fn(seed: u64) RNG {
    mut state: u64 = seed;
    if(state == 0) {
        state = @as(u64, 0x9e3779b97f4a7c15);
    }
    return RNG {
        .state = state,
    };
};

pub next_u64 = fn(self: *mut RNG) u64 {
    mut x: u64 = self.state;
    x = x ^ (x >> @as(u64, 12));
    x = x ^ (x << @as(u64, 25));
    x = x ^ (x >> @as(u64, 27));
    self.state = x;
    return x * @as(u64, 0x2545F4914F6CDD1D);
};

pub next_u32 = fn(self: *mut RNG) u32 {
    return @as(u32, next_u64(self) >> @as(u64, 32));
};

pub next_bool = fn(self: *mut RNG) bool {
    return (next_u64(self) & @as(u64, 1)) != 0;
};

pub next_f32 = fn(self: *mut RNG) f32 {
    value: u32 = next_u32(self);
    return @as(f32, value) / @as(f32, 4294967295.0);
};

pub next_f64 = fn(self: *mut RNG) f64 {
    value: u64 = next_u64(self);
    return @as(f64, value) / @as(f64, 18446744073709551615.0);
};

pub range_u64 = fn(self: *mut RNG, upper_bound: u64) u64 {
    if(upper_bound == 0) {
        return 0;
    }

    threshold: u64 = (0 - upper_bound) % upper_bound;
    mut result: u64 = 0;
    mut done: bool = false;
    while(!done) {
        value: u64 = next_u64(self);
        if(value >= threshold) {
            result = value % upper_bound;
            done = true;
        }
    }
    return result;
};

pub range_i32 = fn(self: *mut RNG, upper_bound: i32) i32 {
    if(upper_bound <= 0) {
        return 0;
    }
    return @as(i32, range_u64(self, @as(u64, upper_bound)));
};
