@package("rand");

pub RNG = struct {
    state: u64,

    next_u64: fn(self: &mut Self) u64 {
        mut x: u64 = self.state;
        x = x ^ (x >> @as(u64, 12));
        x = x ^ (x << @as(u64, 25));
        x = x ^ (x >> @as(u64, 27));
        self.state = x;
        return x * @as(u64, 0x2545F4914F6CDD1D);
    },

    next_u32: fn(self: &mut Self) u32 {
        return @as(u32, self.next_u64() >> @as(u64, 32));
    },

    next_bool: fn(self: &mut Self) bool {
        return (self.next_u64() & @as(u64, 1)) != 0;
    },

    next_f32: fn(self: &mut Self) f32 {
        value: u32 = self.next_u32();
        return @as(f32, value) / @as(f32, 4294967295.0);
    },

    next_f64: fn(self: &mut Self) f64 {
        value: u64 = self.next_u64();
        return @as(f64, value) / @as(f64, 18446744073709551615.0);
    },

    range_u64: fn(self: &mut Self, lower_bound: u64, upper_bound: u64) u64 {
        if(upper_bound <= lower_bound) {
            return lower_bound;
        }
        return lower_bound + sample_below(self, upper_bound - lower_bound);
    },

    range_i32: fn(self: &mut Self, lower_bound: i32, upper_bound: i32) i32 {
        span: i64 = @as(i64, upper_bound) - @as(i64, lower_bound);
        if(span <= 0) {
            return lower_bound;
        }
        return @as(i32, @as(i64, lower_bound) + @as(i64, sample_below(self, @as(u64, span))));
    },
};

sample_below = fn(self: &mut RNG, span: u64) u64 {
    threshold: u64 = (0 - span) % span;
    mut result: u64 = 0;
    mut done: bool = false;
    while(!done) {
        value: u64 = self.next_u64();
        if(value >= threshold) {
            result = value % span;
            done = true;
        }
    }
    return result;
};

pub init = fn(seed: u64) RNG {
    mut state: u64 = seed;
    if(state == 0) {
        state = @as(u64, 0x9e3779b97f4a7c15);
    }
    return RNG {
        .state = state,
    };
};
