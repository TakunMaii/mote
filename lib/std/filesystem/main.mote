@package("filesystem");

c :: @import("std:internal/c");
cstr :: @import("std:internal/cstr");
mem :: @import("std:mem");
str :: @import("std:str");
types :: @import("std:types");

// Thin filesystem helpers layered on C stdio.
// Keep higher-level path manipulation in `std:path`.

pub File :: *void;

pub open :: c.fopen;
pub close :: c.fclose;
pub read :: c.fread;
pub write :: c.fwrite;
pub seek :: c.fseek;
pub tell :: c.ftell;
pub flush :: c.fflush;
pub rewind :: c.rewind;
pub get_char :: c.fgetc;
pub put_char :: c.fputc;
pub get_line :: c.fgets;
pub put_c_string :: c.fputs;
pub eof :: c.feof;
pub error :: c.ferror;
pub remove :: c.remove;
pub rename :: c.rename;

pub seek_set :: c.SEEK_SET;
pub seek_cur :: c.SEEK_CUR;
pub seek_end :: c.SEEK_END;

pub put_string :: fn(handle: File, value: string) bool {
    written: types.size_t = write(@as(*void, str.ptr(value)), 1, @len(value), handle);
    return written == @len(value);
};

with_path :: fn(path: string, action: Function([*char], bool)) bool {
    c_path: *char = cstr.dup_z(path);
    if(c_path == 0) {
        return false;
    }
    ok: bool = action(c_path);
    cstr.free(c_path);
    return ok;
};

with_path_size :: fn(path: string, action: Function([*char], ?types.size_t)) ?types.size_t {
    c_path: *char = cstr.dup_z(path);
    if(c_path == 0) {
        return null;
    }
    result: ?types.size_t = action(c_path);
    cstr.free(c_path);
    return result;
};

with_path_bytes :: fn(path: string, action: Function([*char], ?[]u8)) ?[]u8 {
    c_path: *char = cstr.dup_z(path);
    if(c_path == 0) {
        return null;
    }
    result: ?[]u8 = action(c_path);
    cstr.free(c_path);
    return result;
};

with_two_paths :: fn(lhs: string, rhs: string, action: Function([*char, *char], bool)) bool {
    lhs_c: *char = cstr.dup_z(lhs);
    if(lhs_c == 0) {
        return false;
    }
    rhs_c: *char = cstr.dup_z(rhs);
    if(rhs_c == 0) {
        cstr.free(lhs_c);
        return false;
    }
    ok: bool = action(lhs_c, rhs_c);
    cstr.free(rhs_c);
    cstr.free(lhs_c);
    return ok;
};

exists_c :: fn(path: *char) bool {
    file: File = open(path, "rb");
    if(file == 0) {
        return false;
    }
    close(file);
    return true;
};

pub exists :: fn(path: string) bool {
    return with_path(path, exists_c);
};

file_size_c :: fn(path: *char) ?types.size_t {
    file: File = open(path, "rb");
    if(file == 0) {
        return null;
    }

    if(seek(file, 0, seek_end) != 0) {
        close(file);
        return null;
    }
    end_pos: i64 = tell(file);
    close(file);
    if(end_pos < 0) {
        return null;
    }
    return @as(types.size_t, end_pos);
};

pub file_size :: fn(path: string) ?types.size_t {
    return with_path_size(path, file_size_c);
};

read_all_c :: fn(path: *char) ?[]u8 {
    size: ?types.size_t = file_size_c(path);
    if(size == null) {
        return null;
    }

    len_value: types.size_t = @unwrap(size);
    data: []u8 = mem.make_zeroed(u8, len_value);
    if(len_value == 0) {
        return data;
    }

    file: File = open(path, "rb");
    if(file == 0) {
        mem.free_slice(u8, data);
        return null;
    }
    if(len_value > 0 && seek(file, 0, seek_set) != 0) {
        close(file);
        mem.free_slice(u8, data);
        return null;
    }

    read_count: types.size_t = read(@as(*void, @as(*u8, data)), 1, len_value, file);
    close(file);
    if(read_count != len_value) {
        mem.free_slice(u8, data);
        return null;
    }
    return data;
};

pub read_all :: fn(path: string) ?[]u8 {
    return with_path_bytes(path, read_all_c);
};

write_all_c :: fn(path: *char, data: []u8) bool {
    file: File = open(path, "wb");
    if(file == 0) {
        return false;
    }
    write_count: types.size_t = write(@as(*void, @as(*u8, data)), 1, @len(data), file);
    flush(file);
    close(file);
    return write_count == @len(data);
};

pub write_all :: fn(path: string, data: []u8) bool {
    c_path: *char = cstr.dup_z(path);
    if(c_path == 0) {
        return false;
    }
    ok: bool = write_all_c(c_path, data);
    cstr.free(c_path);
    return ok;
};

remove_file_c :: fn(path: *char) bool {
    return remove(path) == 0;
};

pub remove_file :: fn(path: string) bool {
    return with_path(path, remove_file_c);
};

rename_file_c :: fn(from_path: *char, to_path: *char) bool {
    return rename(from_path, to_path) == 0;
};

pub rename_file :: fn(from_path: string, to_path: string) bool {
    return with_two_paths(from_path, to_path, rename_file_c);
};

directory_exists_c :: fn(path: *char) bool {
    return c.directory_exists(path) != 0;
};

pub directory_exists :: fn(path: string) bool {
    return with_path(path, directory_exists_c);
};

create_directory_c :: fn(path: *char) bool {
    return c.directory_create(path) != 0;
};

pub create_directory :: fn(path: string) bool {
    return with_path(path, create_directory_c);
};

remove_directory_c :: fn(path: *char) bool {
    return c.directory_remove(path) != 0;
};

pub remove_directory :: fn(path: string) bool {
    return with_path(path, remove_directory_c);
};

directory_entry_count_c :: fn(path: *char) ?types.size_t {
    count: i64 = c.directory_entry_count(path);
    if(count < 0) {
        return null;
    }
    return @as(types.size_t, count);
};

pub directory_entry_count :: fn(path: string) ?types.size_t {
    return with_path_size(path, directory_entry_count_c);
};

// Returns a NUL-delimited blob of entry names.
// Each entry occupies `name_bytes + '\0'`.
list_directory_names_c :: fn(path: *char) ?[]char {
    size: i64 = c.directory_list_names(path, 0, 0);
    if(size < 0) {
        return null;
    }

    data: []char = mem.make_zeroed(char, @as(types.size_t, size));
    if(size == 0) {
        return data;
    }

    written: i64 = c.directory_list_names(path, @as(*char, data), size);
    if(written != size) {
        mem.free_slice(char, data);
        return null;
    }
    return data;
};

pub list_directory_names :: fn(path: string) ?[]char {
    c_path: *char = cstr.dup_z(path);
    if(c_path == 0) {
        return null;
    }
    result: ?[]char = list_directory_names_c(c_path);
    cstr.free(c_path);
    return result;
};
