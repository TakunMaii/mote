@package("bytes");

slice = @import("std:slice");
types = @import("std:types");

// Byte-slice helpers built on top of `std:slice`.

pub is_empty = fn(xs: []u8) bool {
    return slice.is_empty(u8, xs);
};

pub equal = fn(xs: []u8, ys: []u8) bool {
    return slice.equal(u8, xs, ys);
};

pub copy = fn(dst: []u8, src: []u8) types.size_t {
    return slice.copy(u8, dst, src);
};

pub fill = fn(xs: []u8, value: u8) void {
    slice.fill(u8, xs, value);
};

pub zero = fn(xs: []u8) void {
    fill(xs, 0);
};

pub starts_with = fn(xs: []u8, prefix: []u8) bool {
    return slice.starts_with(u8, xs, prefix);
};

pub ends_with = fn(xs: []u8, suffix: []u8) bool {
    return slice.ends_with(u8, xs, suffix);
};

pub index_of_byte = fn(xs: []u8, needle: u8) ?types.size_t {
    return slice.index_of(u8, xs, needle);
};

pub index_of_slice = fn(xs: []u8, needle: []u8) ?types.size_t {
    if(@len(needle) == 0) {
        return 0;
    }
    if(@len(needle) > @len(xs)) {
        return null;
    }

    mut index: types.size_t = 0;
    while(index + @len(needle) <= @len(xs)) {
        if(equal(slice.subslice(u8, xs, index, @len(needle)), needle)) {
            return index;
        }
        index = index + 1;
    }
    return null;
};
