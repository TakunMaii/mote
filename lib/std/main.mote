@package("std");

types = @import("std:types");
string = @import("std:string");
io = @import("std:io");
mem = @import("std:mem");
hash = @import("std:hash");
list = @import("std:list");
map = @import("std:map");
set = @import("std:set");

pub byte = types.byte;
pub size_t = types.size_t;

pub string_len = string.len;
pub string_compare = string.compare;
pub string_compare_n = string.compare_n;
pub string_to_int = string.to_int;

pub io_put_char = io.put_char;
pub io_put_str = io.put_str;
pub io_stderr_handle = io.stderr_handle;

pub list_init = fn(T: Type) list.List(T) {
    return list.init(T);
};
pub list_init_cap = fn(T: Type, cap: size_t) list.List(T) {
    return list.init_cap(T, cap);
};
pub list_try_init_cap = fn(T: Type, cap: size_t) ?list.List(T) {
    return list.try_init_cap(T, cap);
};
pub list_init_in_arena = fn(T: Type, arena: mem.Arena) list.List(T) {
    return list.init_in_arena(T, arena);
};
pub list_init_cap_in_arena = fn(T: Type, arena: mem.Arena, cap: size_t) list.List(T) {
    return list.init_cap_in_arena(T, arena, cap);
};
pub list_deinit = fn(T: Type, self: *mut list.List(T)) void {
    list.deinit(T, self);
};
pub list_clear = fn(T: Type, self: *mut list.List(T)) void {
    list.clear(T, self);
};
pub list_is_empty = fn(T: Type, self: *list.List(T)) bool {
    return list.is_empty(T, self);
};
pub list_as_slice = fn(T: Type, self: *list.List(T)) []T {
    return list.as_slice(T, self);
};
pub list_get = fn(T: Type, self: *list.List(T), index: size_t) T {
    return list.get(T, self, index);
};
pub list_get_ptr = fn(T: Type, self: *mut list.List(T), index: size_t) *mut T {
    return list.get_ptr(T, self, index);
};
pub list_set = fn(T: Type, self: *mut list.List(T), index: size_t, value: T) void {
    list.set(T, self, index, value);
};
pub list_try_reserve = fn(T: Type, self: *mut list.List(T), needed_cap: size_t) bool {
    return list.try_reserve(T, self, needed_cap);
};
pub list_reserve = fn(T: Type, self: *mut list.List(T), needed_cap: size_t) void {
    list.reserve(T, self, needed_cap);
};
pub list_try_append = fn(T: Type, self: *mut list.List(T), value: T) bool {
    return list.try_append(T, self, value);
};
pub list_append = fn(T: Type, self: *mut list.List(T), value: T) void {
    list.append(T, self, value);
};
pub list_try_append_slice = fn(T: Type, self: *mut list.List(T), values: []T) bool {
    return list.try_append_slice(T, self, values);
};
pub list_append_slice = fn(T: Type, self: *mut list.List(T), values: []T) void {
    list.append_slice(T, self, values);
};
pub list_pop = fn(T: Type, self: *mut list.List(T)) ?T {
    return list.pop(T, self);
};
pub list_insert = fn(T: Type, self: *mut list.List(T), index: size_t, value: T) void {
    list.insert(T, self, index, value);
};
pub list_remove_at = fn(T: Type, self: *mut list.List(T), index: size_t) T {
    return list.remove_at(T, self, index);
};
pub list_swap_remove = fn(T: Type, self: *mut list.List(T), index: size_t) T {
    return list.swap_remove(T, self, index);
};

pub map_init = fn(K: Type, V: Type, hash_fn: hash.HashFn(K), eq_fn: hash.EqFn(K)) map.Map(K, V) {
    return map.init(K, V, hash_fn, eq_fn);
};
pub map_init_cap = fn(K: Type, V: Type, cap: size_t, hash_fn: hash.HashFn(K), eq_fn: hash.EqFn(K)) map.Map(K, V) {
    return map.init_cap(K, V, cap, hash_fn, eq_fn);
};
pub map_init_in_arena = fn(K: Type, V: Type, arena: mem.Arena, hash_fn: hash.HashFn(K), eq_fn: hash.EqFn(K)) map.Map(K, V) {
    return map.init_in_arena(K, V, arena, hash_fn, eq_fn);
};
pub map_init_cap_in_arena = fn(K: Type, V: Type, arena: mem.Arena, cap: size_t, hash_fn: hash.HashFn(K), eq_fn: hash.EqFn(K)) map.Map(K, V) {
    return map.init_cap_in_arena(K, V, arena, cap, hash_fn, eq_fn);
};
pub map_deinit = fn(K: Type, V: Type, self: *mut map.Map(K, V)) void {
    map.deinit(K, V, self);
};
pub map_clear = fn(K: Type, V: Type, self: *mut map.Map(K, V)) void {
    map.clear(K, V, self);
};
pub map_contains = fn(K: Type, V: Type, self: *map.Map(K, V), key: K) bool {
    return map.contains(K, V, self, key);
};
pub map_get = fn(K: Type, V: Type, self: *map.Map(K, V), key: K) ?V {
    return map.get(K, V, self, key);
};
pub map_get_ptr = fn(K: Type, V: Type, self: *mut map.Map(K, V), key: K) ?*mut V {
    return map.get_ptr(K, V, self, key);
};
pub map_put = fn(K: Type, V: Type, self: *mut map.Map(K, V), key: K, value: V) void {
    map.put(K, V, self, key, value);
};
pub map_remove = fn(K: Type, V: Type, self: *mut map.Map(K, V), key: K) bool {
    return map.remove(K, V, self, key);
};

pub set_init = fn(T: Type, hash_fn: hash.HashFn(T), eq_fn: hash.EqFn(T)) set.Set(T) {
    return set.init(T, hash_fn, eq_fn);
};
pub set_init_cap = fn(T: Type, cap: size_t, hash_fn: hash.HashFn(T), eq_fn: hash.EqFn(T)) set.Set(T) {
    return set.init_cap(T, cap, hash_fn, eq_fn);
};
pub set_init_in_arena = fn(T: Type, arena: mem.Arena, hash_fn: hash.HashFn(T), eq_fn: hash.EqFn(T)) set.Set(T) {
    return set.init_in_arena(T, arena, hash_fn, eq_fn);
};
pub set_init_cap_in_arena = fn(T: Type, arena: mem.Arena, cap: size_t, hash_fn: hash.HashFn(T), eq_fn: hash.EqFn(T)) set.Set(T) {
    return set.init_cap_in_arena(T, arena, cap, hash_fn, eq_fn);
};
pub set_deinit = fn(T: Type, self: *mut set.Set(T)) void {
    set.deinit(T, self);
};
pub set_clear = fn(T: Type, self: *mut set.Set(T)) void {
    set.clear(T, self);
};
pub set_contains = fn(T: Type, self: *set.Set(T), value: T) bool {
    return set.contains(T, self, value);
};
pub set_insert = fn(T: Type, self: *mut set.Set(T), value: T) void {
    set.insert(T, self, value);
};
pub set_remove = fn(T: Type, self: *mut set.Set(T), value: T) bool {
    return set.remove(T, self, value);
};

pub hash_mix_u64 = hash.mix_u64;
pub hash_bool = hash.hash_bool;
pub hash_i32 = hash.hash_i32;
pub hash_i64 = hash.hash_i64;
pub hash_u32 = hash.hash_u32;
pub hash_u64 = hash.hash_u64;
pub hash_c_string = hash.hash_c_string;
pub eq_bool = hash.eq_bool;
pub eq_i32 = hash.eq_i32;
pub eq_i64 = hash.eq_i64;
pub eq_u32 = hash.eq_u32;
pub eq_u64 = hash.eq_u64;
pub eq_c_string = hash.eq_c_string;
