@package("set");

map :: @import("std:map");
mem :: @import("std:mem");
types :: @import("std:types");
hash :: @import("std:hash");

pub Set :: fn(T: Type) Type {
    return struct {
        inner: map.Map(T, bool),

        deinit: fn(self: &Self) void {
            self.inner.deinit();
        },

        clear: fn(self: &Self) void {
            self.inner.clear();
        },

        contains: fn(self: &Self, value: T) bool {
            return self.inner.contains(value);
        },

        insert: fn(self: &Self, value: T) void {
            self.inner.put(value, true);
        },

        remove: fn(self: &Self, value: T) bool {
            return self.inner.remove(value);
        },
    };
};

pub init :: fn(T: Type, hash_fn: hash.HashFn(T), eq_fn: hash.EqFn(T)) Set(T) {
    return Set(T) {
        .inner = map.init(T, bool, hash_fn, eq_fn),
    };
};

pub init_in_arena :: fn(T: Type, arena: mem.Arena, hash_fn: hash.HashFn(T), eq_fn: hash.EqFn(T)) Set(T) {
    return Set(T) {
        .inner = map.init_in_arena(T, bool, arena, hash_fn, eq_fn),
    };
};

pub init_cap :: fn(T: Type, cap: types.size_t, hash_fn: hash.HashFn(T), eq_fn: hash.EqFn(T)) Set(T) {
    return Set(T) {
        .inner = map.init_cap(T, bool, cap, hash_fn, eq_fn),
    };
};

pub init_cap_in_arena :: fn(T: Type, arena: mem.Arena, cap: types.size_t, hash_fn: hash.HashFn(T), eq_fn: hash.EqFn(T)) Set(T) {
    return Set(T) {
        .inner = map.init_cap_in_arena(T, bool, arena, cap, hash_fn, eq_fn),
    };
};
