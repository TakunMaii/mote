@package("list");

mem :: @import("std:mem");
types :: @import("std:types");
c :: @import("std:internal/c");

pub List :: fn(T: Type) Type {
    return struct {
        data: []T,
        len: types.size_t,
        cap: types.size_t,
        arena: mem.Arena,
        uses_arena: bool,

        deinit: fn(self: &Self) void {
            if(!self.uses_arena && self.cap > 0) {
                c.dealloc(@as(*void, &self.data[0]));
            }
            self.data = @slice(T, @as(*T, 0), 0);
            self.len = 0;
            self.cap = 0;
            self.arena = mem.Arena { .state = 0 };
            self.uses_arena = false;
        },

        clear: fn(self: &Self) void {
            self.len = 0;
        },

        is_empty: fn(self: &Self) bool {
            return self.len == 0;
        },

        as_slice: fn(self: &Self) []T {
            return @slice(T, @as(*T, self.data), self.len);
        },

        get: fn(self: &Self, index: types.size_t) T {
            return self.data[index];
        },

        get_ptr: fn(self: &Self, index: types.size_t) *T {
            return &self.data[index];
        },

        set: fn(self: &Self, index: types.size_t, value: T) void {
            self.data[index] = value;
        },

        try_reserve: fn(self: &Self, needed_cap: types.size_t) bool {
            if(needed_cap <= self.cap) {
                return true;
            }

            new_cap: types.size_t = self.cap;
            if(new_cap < 4) {
                new_cap = 4;
            }
            while(new_cap < needed_cap) {
                new_cap = new_cap * 2;
            }

            if(self.uses_arena) {
                new_data: []T = mem.arena_make(T, self.arena, new_cap);
                if(self.len > 0) {
                    mem.copy(@as(*void, &new_data[0]),
                             @as(*void, &self.data[0]),
                             @sizeof(T) * self.len);
                }
                self.data = new_data;
                self.cap = new_cap;
                return true;
            }

            if(self.cap == 0) {
                maybe_data: ?[]T = mem.try_make(T, new_cap);
                if(maybe_data == null) {
                    return false;
                }
                self.data = @unwrap(maybe_data);
                self.cap = new_cap;
                return true;
            }

            new_ptr: *T = @as(*T,
                              mem.realloc(@as(*void, &self.data[0]),
                                          @sizeof(T) * new_cap));
            if(new_ptr == 0) {
                return false;
            }
            self.data = @slice(T, new_ptr, new_cap);
            self.cap = new_cap;
            return true;
        },

        reserve: fn(self: &Self, needed_cap: types.size_t) void {
            self.try_reserve(needed_cap);
        },

        try_append: fn(self: &Self, value: T) bool {
            if(!self.try_reserve(self.len + 1)) {
                return false;
            }
            self.data[self.len] = value;
            self.len = self.len + 1;
            return true;
        },

        append: fn(self: &Self, value: T) void {
            self.try_append(value);
        },

        try_append_slice: fn(self: &Self, values: []T) bool {
            new_len: types.size_t = self.len + @len(values);
            if(!self.try_reserve(new_len)) {
                return false;
            }
            if(@len(values) > 0) {
                mem.copy(@as(*void, &self.data[self.len]),
                         @as(*void, @as(*T, values)),
                         @sizeof(T) * @len(values));
            }
            self.len = new_len;
            return true;
        },

        append_slice: fn(self: &Self, values: []T) void {
            self.try_append_slice(values);
        },

        pop: fn(self: &Self) ?T {
            if(self.len == 0) {
                return null;
            }
            self.len = self.len - 1;
            return self.data[self.len];
        },

        insert: fn(self: &Self, index: types.size_t, value: T) void {
            if(!self.try_reserve(self.len + 1)) {
                return;
            }
            if(index < self.len) {
                mem.move(@as(*void, &self.data[index + 1]),
                         @as(*void, &self.data[index]),
                         @sizeof(T) * (self.len - index));
            }
            self.data[index] = value;
            self.len = self.len + 1;
        },

        remove_at: fn(self: &Self, index: types.size_t) T {
            value: T = self.data[index];
            if(index + 1 < self.len) {
                mem.move(@as(*void, &self.data[index]),
                         @as(*void, &self.data[index + 1]),
                         @sizeof(T) * (self.len - index - 1));
            }
            self.len = self.len - 1;
            return value;
        },

        swap_remove: fn(self: &Self, index: types.size_t) T {
            value: T = self.data[index];
            self.len = self.len - 1;
            if(index < self.len) {
                self.data[index] = self.data[self.len];
            }
            return value;
        },
    };
};

pub init :: fn(T: Type) List(T) {
    return List(T) {
        .data = @slice(T, @as(*T, 0), 0),
        .len = 0,
        .cap = 0,
        .arena = mem.Arena { .state = 0 },
        .uses_arena = false,
    };
};

pub init_cap :: fn(T: Type, cap: types.size_t) List(T) {
    list: List(T) = init(T);
    if(cap > 0) {
        list.data = mem.make(T, cap);
        list.cap = cap;
    }
    return list;
};

pub try_init_cap :: fn(T: Type, cap: types.size_t) ?List(T) {
    list: List(T) = init(T);
    if(cap == 0) {
        return list;
    }
    maybe_data: ?[]T = mem.try_make(T, cap);
    if(maybe_data == null) {
        return null;
    }
    list.data = @unwrap(maybe_data);
    list.cap = cap;
    return list;
};

pub init_in_arena :: fn(T: Type, arena: mem.Arena) List(T) {
    list: List(T) = init(T);
    list.arena = arena;
    list.uses_arena = true;
    return list;
};

pub init_cap_in_arena :: fn(T: Type, arena: mem.Arena, cap: types.size_t) List(T) {
    list: List(T) = init_in_arena(T, arena);
    if(cap > 0) {
        list.data = mem.arena_make(T, arena, cap);
        list.cap = cap;
    }
    return list;
};
