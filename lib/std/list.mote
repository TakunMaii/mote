mem = @import("std/mem");
types = @import("std/types");

pub List = fn(T: Type) Type {
    return struct {
        data: []T,
        len: types.size_t,
        cap: types.size_t,
        arena: mem.Arena,
        uses_arena: bool,
    };
};

pub init = fn(T: Type) List(T) {
    return List(T) {
        .data = @slice(T, @as(*mut T, 0), 0),
        .len = 0,
        .cap = 0,
        .arena = mem.Arena { .state = 0 },
        .uses_arena = false,
    };
};

pub init_cap = fn(T: Type, cap: types.size_t) List(T) {
    mut list: List(T) = init(T);
    if(cap > 0) {
        list.data = mem.make(T, cap);
        list.cap = cap;
    }
    return list;
};

pub try_init_cap = fn(T: Type, cap: types.size_t) ?List(T) {
    mut list: List(T) = init(T);
    if(cap == 0) {
        return list;
    }
    maybe_data: ?[]T = mem.try_make(T, cap);
    if(maybe_data == null) {
        return null;
    }
    list.data = @unwrap(maybe_data);
    list.cap = cap;
    return list;
};

pub init_in_arena = fn(T: Type, arena: mem.Arena) List(T) {
    mut list: List(T) = init(T);
    list.arena = arena;
    list.uses_arena = true;
    return list;
};

pub init_cap_in_arena = fn(T: Type, arena: mem.Arena, cap: types.size_t) List(T) {
    mut list: List(T) = init_in_arena(T, arena);
    if(cap > 0) {
        list.data = mem.arena_make(T, arena, cap);
        list.cap = cap;
    }
    return list;
};

pub deinit = fn(T: Type, self: *mut List(T)) void {
    if(!self.uses_arena && self.cap > 0) {
        mem.free_slice(T, self.data);
    }
    self.data = @slice(T, @as(*mut T, 0), 0);
    self.len = 0;
    self.cap = 0;
    self.arena = mem.Arena { .state = 0 };
    self.uses_arena = false;
};

pub clear = fn(T: Type, self: *mut List(T)) void {
    self.len = 0;
};

pub is_empty = fn(T: Type, self: *List(T)) bool {
    return self.len == 0;
};

pub as_slice = fn(T: Type, self: *List(T)) []T {
    return @slice(T, @as(*mut T, self.data), self.len);
};

pub get = fn(T: Type, self: *List(T), index: types.size_t) T {
    return self.data[index];
};

pub get_ptr = fn(T: Type, self: *mut List(T), index: types.size_t) *mut T {
    return &mut self.data[index];
};

pub set = fn(T: Type, self: *mut List(T), index: types.size_t, value: T) void {
    self.data[index] = value;
};

pub try_reserve = fn(T: Type, self: *mut List(T), needed_cap: types.size_t) bool {
    if(needed_cap <= self.cap) {
        return true;
    }

    mut new_cap: types.size_t = self.cap;
    if(new_cap < 4) {
        new_cap = 4;
    }
    while(new_cap < needed_cap) {
        new_cap = new_cap * 2;
    }

    if(self.uses_arena) {
        new_data: []T = mem.arena_make(T, self.arena, new_cap);
        if(self.len > 0) {
            mem.copy(@as(*mut void, @as(*mut T, new_data)),
                     @as(*void, @as(*T, self.data)),
                     @sizeof(T) * self.len);
        }
        self.data = new_data;
        self.cap = new_cap;
        return true;
    }

    if(self.cap == 0) {
        maybe_data: ?[]T = mem.try_make(T, new_cap);
        if(maybe_data == null) {
            return false;
        }
        self.data = @unwrap(maybe_data);
        self.cap = new_cap;
        return true;
    }

    new_ptr: *mut T = @as(*mut T,
                          mem.realloc(@as(*void, @as(*mut T, self.data)),
                                      @sizeof(T) * new_cap));
    if(new_ptr == 0) {
        return false;
    }
    self.data = @slice(T, new_ptr, new_cap);
    self.cap = new_cap;
    return true;
};

pub reserve = fn(T: Type, self: *mut List(T), needed_cap: types.size_t) void {
    ok: bool = try_reserve(T, self, needed_cap);
    if(!ok) {
        return;
    }
};

pub try_append = fn(T: Type, self: *mut List(T), value: T) bool {
    if(!try_reserve(T, self, self.len + 1)) {
        return false;
    }
    self.data[self.len] = value;
    self.len = self.len + 1;
    return true;
};

pub append = fn(T: Type, self: *mut List(T), value: T) void {
    try_append(T, self, value);
};

pub try_append_slice = fn(T: Type, self: *mut List(T), values: []T) bool {
    new_len: types.size_t = self.len + @len(values);
    if(!try_reserve(T, self, new_len)) {
        return false;
    }
    if(@len(values) > 0) {
        mem.copy(@as(*mut void, &mut self.data[self.len]),
                 @as(*void, @as(*T, values)),
                 @sizeof(T) * @len(values));
    }
    self.len = new_len;
    return true;
};

pub append_slice = fn(T: Type, self: *mut List(T), values: []T) void {
    try_append_slice(T, self, values);
};

pub pop = fn(T: Type, self: *mut List(T)) ?T {
    if(self.len == 0) {
        return null;
    }
    self.len = self.len - 1;
    return self.data[self.len];
};

pub insert = fn(T: Type, self: *mut List(T), index: types.size_t, value: T) void {
    if(!try_reserve(T, self, self.len + 1)) {
        return;
    }
    if(index < self.len) {
        mem.move(@as(*mut void, &mut self.data[index + 1]),
                 @as(*void, &self.data[index]),
                 @sizeof(T) * (self.len - index));
    }
    self.data[index] = value;
    self.len = self.len + 1;
};

pub remove_at = fn(T: Type, self: *mut List(T), index: types.size_t) T {
    value: T = self.data[index];
    if(index + 1 < self.len) {
        mem.move(@as(*mut void, &mut self.data[index]),
                 @as(*void, &self.data[index + 1]),
                 @sizeof(T) * (self.len - index - 1));
    }
    self.len = self.len - 1;
    return value;
};

pub swap_remove = fn(T: Type, self: *mut List(T), index: types.size_t) T {
    value: T = self.data[index];
    self.len = self.len - 1;
    if(index < self.len) {
        self.data[index] = self.data[self.len];
    }
    return value;
};
