@package("string");

str :: @import("std:str");

pub len :: str.len;
pub is_empty :: str.is_empty;
pub equal :: str.equal;
pub starts_with :: str.starts_with;
pub ends_with :: str.ends_with;
pub index_of :: str.index_of;
pub ptr :: str.ptr;
pub from_chars :: str.from_chars;
pub from_ptr_len :: str.from_ptr_len;
pub from_c_string :: str.from_c_string;
pub to_chars :: str.to_chars;
pub parse_u64 :: str.parse_u64;
pub parse_i64 :: str.parse_i64;
pub trim_start :: str.trim_start;
pub trim_end :: str.trim_end;
pub trim :: str.trim;
