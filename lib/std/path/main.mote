@package("path");

slice :: @import("std:slice");
str :: @import("std:str");
types :: @import("std:types");

// Pure path-string utilities only.
// This module does not touch the filesystem and does not allocate implicitly.

pub is_separator :: fn(ch: char) bool {
    return ch == '/' || ch == '\\';
};

pub is_alpha :: fn(ch: char) bool {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z');
};

pub is_abs :: fn(value: string) bool {
    len: types.size_t = @len(value);
    if(len == 0) {
        return false;
    }
    if(is_separator(value[0])) {
        return true;
    }
    if(len >= 3 && is_alpha(value[0]) && value[1] == ':' && is_separator(value[2])) {
        return true;
    }
    return false;
};

pub root_len :: fn(value: string) types.size_t {
    len: types.size_t = @len(value);
    if(len == 0) {
        return 0;
    }
    if(is_separator(value[0])) {
        return 1;
    }
    if(len >= 3 && is_alpha(value[0]) && value[1] == ':' && is_separator(value[2])) {
        return 3;
    }
    if(len >= 2 && is_alpha(value[0]) && value[1] == ':') {
        return 2;
    }
    return 0;
};

pub trim_trailing_separators :: fn(value: string) string {
    len: types.size_t = @len(value);
    root: types.size_t = root_len(value);
    while(len > root && is_separator(value[len - 1])) {
        len = len - 1;
    }
    return @as(string, slice.head(char, @as([]char, value), len));
};

pub basename :: fn(value: string) string {
    trimmed: string = trim_trailing_separators(value);
    len: types.size_t = @len(trimmed);
    root: types.size_t = root_len(trimmed);
    if(len == 0) {
        return trimmed;
    }
    if(len == root) {
        return trimmed;
    }

    index: types.size_t = len;
    while(index > root) {
        if(is_separator(trimmed[index - 1])) {
            return @as(string, slice.subslice(char, @as([]char, trimmed), index, len - index));
        }
        index = index - 1;
    }
    return trimmed;
};

pub dirname :: fn(value: string) string {
    trimmed: string = trim_trailing_separators(value);
    len: types.size_t = @len(trimmed);
    root: types.size_t = root_len(trimmed);
    if(len == 0) {
        return trimmed;
    }
    if(len == root) {
        return trimmed;
    }

    index: types.size_t = len;
    while(index > root) {
        if(is_separator(trimmed[index - 1])) {
            end: types.size_t = index - 1;
            while(end > root && is_separator(trimmed[end - 1])) {
                end = end - 1;
            }
            return @as(string, slice.head(char, @as([]char, trimmed), end));
        }
        index = index - 1;
    }

    return @as(string, slice.head(char, @as([]char, trimmed), 0));
};

pub extension :: fn(value: string) string {
    base: string = basename(value);
    len: types.size_t = @len(base);
    if(len <= 1) {
        return @as(string, slice.head(char, @as([]char, base), 0));
    }

    index: types.size_t = len;
    while(index > 0) {
        ch: char = base[index - 1];
        if(ch == '.') {
            if(index == 1 || index == len) {
                return @as(string, slice.head(char, @as([]char, base), 0));
            }
            return @as(string, slice.subslice(char, @as([]char, base), index, len - index));
        }
        index = index - 1;
    }

    return @as(string, slice.head(char, @as([]char, base), 0));
};

pub has_extension :: fn(value: string) bool {
    return @len(extension(value)) > 0;
};

pub stem :: fn(value: string) string {
    base: string = basename(value);
    ext: string = extension(value);
    if(@len(ext) == 0) {
        return base;
    }
    return @as(string, slice.head(char, @as([]char, base), @len(base) - @len(ext) - 1));
};

pub join :: fn(dst: []char, left: string, right: string) ?types.size_t {
    if(@len(dst) == 0) {
        return null;
    }

    if(@len(right) == 0) {
        written: types.size_t = slice.copy(char, dst, @as([]char, left));
        if(written != @len(left)) {
            return null;
        }
        return written;
    }

    if(is_abs(right) || @len(left) == 0) {
        written: types.size_t = slice.copy(char, dst, @as([]char, right));
        if(written != @len(right)) {
            return null;
        }
        return written;
    }

    left_trimmed: string = trim_trailing_separators(left);
    total: types.size_t = @len(left_trimmed) + 1 + @len(right);
    if(total > @len(dst)) {
        return null;
    }

    copied: types.size_t = slice.copy(char, dst, @as([]char, left_trimmed));
    dst[copied] = '/';
    copied = copied + 1;

    right_written: types.size_t = slice.copy(char,
                                             slice.subslice(char, dst, copied, @len(dst) - copied),
                                             @as([]char, right));
    if(right_written != @len(right)) {
        return null;
    }
    return copied + right_written;
};

pub normalize :: fn(dst: []char, value: string) ?types.size_t {
    if(@len(dst) == 0 && @len(value) != 0) {
        return null;
    }

    root: types.size_t = root_len(value);
    if(root > @len(dst)) {
        return null;
    }

    out: types.size_t = 0;
    i: types.size_t = 0;
    while(i < root) {
        ch: char = value[i];
        if(is_separator(ch)) {
            ch = '/';
        }
        dst[out] = ch;
        out = out + 1;
        i = i + 1;
    }

    wrote_component: bool = false;
    while(i < @len(value)) {
        while(i < @len(value) && is_separator(value[i])) {
            i = i + 1;
        }
        if(i >= @len(value)) {
            break;
        }

        start: types.size_t = i;
        while(i < @len(value) && !is_separator(value[i])) {
            i = i + 1;
        }
        component: string = @as(string, slice.subslice(char, @as([]char, value), start, i - start));

        if(@len(component) == 1 && component[0] == '.') {
            continue;
        }

        if(wrote_component || (out > 0 && out > root && dst[out - 1] != '/')) {
            if(out >= @len(dst)) {
                return null;
            }
            dst[out] = '/';
            out = out + 1;
        }

        copied: types.size_t = slice.copy(char,
                                          slice.subslice(char, dst, out, @len(dst) - out),
                                          @as([]char, component));
        if(copied != @len(component)) {
            return null;
        }
        out = out + copied;
        wrote_component = true;
    }

    if(out == 0 && root > 0) {
        return root;
    }

    return out;
};
