@package("str");

c :: @import("std:internal/c");
mem :: @import("std:mem");
slice :: @import("std:slice");
types :: @import("std:types");

is_digit :: fn(ch: char) bool {
    return ch >= '0' && ch <= '9';
};

digit_value :: fn(ch: char) u64 {
    return @as(u64, ch - '0');
};

pub len :: fn(value: string) types.size_t {
    return @len(value);
};

pub is_empty :: fn(value: string) bool {
    return @len(value) == 0;
};

pub equal :: fn(lhs: string, rhs: string) bool {
    return slice.equal(char, @as([]char, lhs), @as([]char, rhs));
};

pub starts_with :: fn(value: string, prefix: string) bool {
    return slice.starts_with(char, @as([]char, value), @as([]char, prefix));
};

pub ends_with :: fn(value: string, suffix: string) bool {
    return slice.ends_with(char, @as([]char, value), @as([]char, suffix));
};

pub index_of :: fn(value: string, needle: char) ?types.size_t {
    return slice.index_of(char, @as([]char, value), needle);
};

pub ptr :: fn(value: string) *char {
    return @as(*char, value);
};

pub from_chars :: fn(value: []char) string {
    return @as(string, value);
};

pub from_ptr_len :: fn(ptr: *char, len_value: types.size_t) string {
    return @as(string, @slice(char, ptr, len_value));
};

pub from_c_string :: fn(value: *char) string {
    return from_ptr_len(value, c.strlen(value));
};

pub to_chars :: fn(value: string) []char {
    copied: []char = mem.make(char, @len(value));
    written: types.size_t = slice.copy(char, copied, @as([]char, value));
    if(written != @len(value)) {
        mem.free_slice(char, copied);
        return mem.make(char, 0);
    }
    return copied;
};

pub parse_u64 :: fn(value: string) ?u64 {
    if(@len(value) == 0) {
        return null;
    }

    parsed: u64 = 0;
    index: types.size_t = 0;
    while(index < @len(value)) {
        ch: char = value[index];
        if(!is_digit(ch)) {
            return null;
        }

        digit: u64 = digit_value(ch);
        if(parsed > @as(u64, 1844674407370955161)) {
            return null;
        }
        if(parsed == @as(u64, 1844674407370955161) && digit > @as(u64, 5)) {
            return null;
        }

        parsed = parsed * @as(u64, 10) + digit;
        index = index + 1;
    }
    return parsed;
};

pub parse_i64 :: fn(value: string) ?i64 {
    if(@len(value) == 0) {
        return null;
    }

    index: types.size_t = 0;
    negative: bool = false;
    if(value[0] == '+' || value[0] == '-') {
        negative = value[0] == '-';
        index = 1;
    }
    if(index >= @len(value)) {
        return null;
    }

    parsed: u64 = 0;
    limit: u64 = @as(u64, 9223372036854775807);
    if(negative) {
        limit = @as(u64, 9223372036854775808);
    }

    while(index < @len(value)) {
        ch: char = value[index];
        if(!is_digit(ch)) {
            return null;
        }

        digit: u64 = digit_value(ch);
        if(parsed > limit / @as(u64, 10)) {
            return null;
        }
        if(parsed == limit / @as(u64, 10) && digit > limit % @as(u64, 10)) {
            return null;
        }

        parsed = parsed * @as(u64, 10) + digit;
        index = index + 1;
    }

    if(negative) {
        if(parsed == @as(u64, 9223372036854775808)) {
            return (0 - @as(i64, 9223372036854775807)) - 1;
        }
        return 0 - @as(i64, parsed);
    }
    return @as(i64, parsed);
};

pub trim_start :: fn(value: string, ch: char) string {
    index: types.size_t = 0;
    while(index < @len(value) && value[index] == ch) {
        index = index + 1;
    }
    return @as(string, slice.subslice(char, @as([]char, value), index, @len(value) - index));
};

pub trim_end :: fn(value: string, ch: char) string {
    len_value: types.size_t = @len(value);
    while(len_value > 0 && value[len_value - 1] == ch) {
        len_value = len_value - 1;
    }
    return @as(string, slice.head(char, @as([]char, value), len_value));
};

pub trim :: fn(value: string, ch: char) string {
    return trim_end(trim_start(value, ch), ch);
};
