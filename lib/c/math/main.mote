@package("math");

pub sinf :: @extern("mote_sinf", Function([f32], f32));
pub sin :: @extern("mote_sin", Function([f64], f64));
pub cosf :: @extern("mote_cosf", Function([f32], f32));
pub cos :: @extern("mote_cos", Function([f64], f64));
pub sqrtf :: @extern("mote_sqrtf", Function([f32], f32));
pub sqrt :: @extern("mote_sqrt", Function([f64], f64));
pub fabs :: @extern("mote_fabs", Function([f64], f64));
pub fabsf :: fn(x: f32) f32 {
    return @as(f32, fabs(@as(f64, x)));
};
pub tanf :: @extern("mote_tanf", Function([f32], f32));
pub tan :: @extern("mote_tan", Function([f64], f64));
pub asinf :: @extern("mote_asinf", Function([f32], f32));
pub asin :: @extern("mote_asin", Function([f64], f64));
pub acosf :: @extern("mote_acosf", Function([f32], f32));
pub acos :: @extern("mote_acos", Function([f64], f64));
pub atanf :: @extern("mote_atanf", Function([f32], f32));
pub atan :: @extern("mote_atan", Function([f64], f64));
pub atan2f :: @extern("mote_atan2f", Function([f32, f32], f32));
pub atan2 :: @extern("mote_atan2", Function([f64, f64], f64));
pub expf :: @extern("mote_expf", Function([f32], f32));
pub exp :: @extern("mote_exp", Function([f64], f64));
pub logf :: @extern("mote_logf", Function([f32], f32));
pub log :: @extern("mote_log", Function([f64], f64));
pub log2f :: @extern("mote_log2f", Function([f32], f32));
pub log2 :: @extern("mote_log2", Function([f64], f64));
pub log10f :: @extern("mote_log10f", Function([f32], f32));
pub log10 :: @extern("mote_log10", Function([f64], f64));
pub powf :: @extern("mote_powf", Function([f32, f32], f32));
pub pow :: @extern("mote_pow", Function([f64, f64], f64));
pub floorf :: @extern("mote_floorf", Function([f32], f32));
pub floor :: @extern("mote_floor", Function([f64], f64));
pub ceilf :: @extern("mote_ceilf", Function([f32], f32));
pub ceil :: @extern("mote_ceil", Function([f64], f64));
pub roundf :: @extern("mote_roundf", Function([f32], f32));
pub round :: @extern("mote_round", Function([f64], f64));
pub truncf :: @extern("mote_truncf", Function([f32], f32));
pub trunc :: @extern("mote_trunc", Function([f64], f64));
pub fminf :: @extern("mote_fminf", Function([f32, f32], f32));
pub fmin :: @extern("mote_fmin", Function([f64, f64], f64));
pub fmaxf :: @extern("mote_fmaxf", Function([f32, f32], f32));
