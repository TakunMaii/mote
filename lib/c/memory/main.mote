@package("memory");

pub size_t :: i64;

pub malloc :: @extern("malloc", Function([size_t], *void));
pub calloc :: @extern("calloc", Function([size_t, size_t], *void));
pub realloc :: @extern("realloc", Function([*void, size_t], *void));
pub free :: @extern("free", Function([*void], void));
pub memcpy :: @extern("memcpy", Function([*void, *void, size_t], *void));
pub memmove :: @extern("memmove", Function([*void, *void, size_t], *void));
pub memset :: @extern("memset", Function([*void, i32, size_t], *void));
pub memcmp :: @extern("memcmp", Function([*void, *void, size_t], i32));