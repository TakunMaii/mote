@package("c");

pub size_t = i64;

pub SEEK_SET = 0;
pub SEEK_CUR = 1;
pub SEEK_END = 2;

pub malloc = @extern("malloc", Function([size_t], *mut void));
pub calloc = @extern("calloc", Function([size_t, size_t], *mut void));
pub realloc = @extern("realloc", Function([*void, size_t], *mut void));
pub free = @extern("free", Function([*void], void));
pub memcpy = @extern("memcpy", Function([*mut void, *void, size_t], *mut void));
pub memmove = @extern("memmove", Function([*mut void, *void, size_t], *mut void));
pub memset = @extern("memset", Function([*mut void, i32, size_t], *mut void));
pub memcmp = @extern("memcmp", Function([*void, *void, size_t], i32));

pub fopen = @extern("fopen", Function([*char, *char], *void));
pub fclose = @extern("fclose", Function([*void], i32));
pub fread = @extern("fread", Function([*mut void, size_t, size_t, *void], size_t));
pub fwrite = @extern("fwrite", Function([*void, size_t, size_t, *void], size_t));
pub fseek = @extern("fseek", Function([*void, i64, i32], i32));
pub ftell = @extern("ftell", Function([*void], i64));
pub fflush = @extern("fflush", Function([*void], i32));
pub rewind = @extern("rewind", Function([*void], void));
pub fgetc = @extern("fgetc", Function([*void], i32));
pub fputc = @extern("fputc", Function([i32, *void], i32));
pub fgets = @extern("fgets", Function([*mut char, i32, *void], *mut char));
pub fputs = @extern("fputs", Function([*char, *void], i32));
pub feof = @extern("feof", Function([*void], i32));
pub ferror = @extern("ferror", Function([*void], i32));
pub remove = @extern("remove", Function([*char], i32));
pub rename = @extern("rename", Function([*char, *char], i32));

pub putchar = @extern("putchar", Function([i32], i32));
pub puts = @extern("puts", Function([*char], i32));

pub strlen = @extern("strlen", Function([*char], size_t));
pub strcmp = @extern("strcmp", Function([*char, *char], i32));
pub strncmp = @extern("strncmp", Function([*char, *char, size_t], i32));

pub isdigit = @extern("isdigit", Function([i32], i32));
pub atoi = @extern("atoi", Function([*char], i32));

pub monotonic_ns = @extern("mote_time_monotonic_ns", Function([], u64));
pub sleep_ms = @extern("mote_sleep_ms", Function([i64], void));
pub directory_create = @extern("mote_directory_create", Function([*char], i64));
