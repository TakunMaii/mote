pub atan = @extern("mote_atan", Function([f64], f64));
pub atan2f = @extern("mote_atan2f", Function([f32, f32], f32));
pub atan2 = @extern("mote_atan2", Function([f64, f64], f64));
pub expf = @extern("mote_expf", Function([f32], f32));
pub exp = @extern("mote_exp", Function([f64], f64));
pub logf = @extern("mote_logf", Function([f32], f32));
